# Response headers (Cloudflare Workers static assets; the same _headers format as Pages).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Staging: every *.workers.dev address of this Worker (knowpsyche.<account>.workers.dev and its preview
# URLs) must never be indexed. Host-specific, so knowpsyche.com is not affected. Remove on launch day
# (CLAUDE.md, launch checklist).
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

# The project.pages.dev domain must never be indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Preview deploys (abc123.knowpsyche.pages.dev) must never be indexed either.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Hashed JS, CSS and fonts (Astro bundles the @fontsource files here). A new build gives new names.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# OG images keep their names between builds, so cache them for a day only.
/og/*
  Cache-Control: public, max-age=86400
