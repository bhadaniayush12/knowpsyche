# Response headers (Cloudflare Workers static assets; the same _headers format as Pages).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Hashed JS, CSS and fonts (Astro bundles the @fontsource files here). A new build gives new names.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# OG images keep their names between builds, so cache them for a day only.
/og/*
  Cache-Control: public, max-age=86400
