---
import { nextAfter } from '../../data/home';

interface Props {
  /** This test's path. The next one comes from the shared test list, in doc order; after the last, /tests/. */
  from: string;
  /** The "What next?" line. */
  line: string;
  learn: { href: string; label: string };
}
const { from, line, learn } = Astro.props;
const next = nextAfter(from);
---
<div class="flex flex-col gap-4">
  <h3 class="mono m-0 text-[11px] font-medium text-muted">What next?</h3>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-4">
    <a href={next?.href ?? '/tests/'} class="flex min-h-[150px] flex-col gap-2.5 border border-t-[5px] border-ink border-t-blue bg-card p-5 no-underline">
      <span class="mono text-[10.5px] text-blue">{next ? `Next test · ${next.time}` : 'All tests'}</span>
      <span class="text-[26px] font-semibold tracking-[-.04em]">{next?.name ?? 'All tests'} →</span>
      <span class="text-[15px] leading-[1.5] text-ink-soft">{line}</span>
    </a>
    <a href={learn.href} class="flex min-h-[150px] flex-col justify-end gap-2.5 border border-ink bg-lilac p-5 no-underline">
      <span class="mono text-[10.5px] text-ink-soft">Learn</span>
      <span class="serif text-[28px] leading-[1.05]">{learn.label}</span>
    </a>
  </div>
</div>
