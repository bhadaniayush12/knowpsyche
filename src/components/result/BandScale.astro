---
/**
 * Band bar with a "You · N" marker. The page script sets `[data-r=marker]` and `[data-r=marker-label]`
 * (`style.left` in %, label text). Decorative: the score itself is always given in text too.
 */
interface Props {
  /** One per band, left to right. `class` sets flex weight and colour, e.g. "flex-[2] bg-blue". */
  segments: { class: string; range?: string; label?: string }[];
  /** Tick labels spread under the bar. Leave out to show each segment's `range` + `label` under it instead. */
  ticks?: string[];
  class?: string;
}
const { segments, ticks, class: className } = Astro.props;
---
<div class:list={['border border-ink bg-card px-[22px] pt-[46px] pb-3.5', className]}>
  <div class="bs-bar relative flex h-10 border border-ink" aria-hidden="true">
    {segments.map((s, i) => <div class:list={[s.class, i > 0 && 'border-l border-ink']}></div>)}
    <div data-r="marker" class="absolute -top-3 -bottom-3 w-1 -translate-x-0.5 bg-coral" style="left:0%"></div>
    <div data-r="marker-label" class="bs-label mono absolute -top-[38px] bg-coral-ink px-[7px] py-[3px] text-[11px] whitespace-nowrap text-white" style="--p:0"></div>
  </div>
  {ticks ? (
    <div class="mono mt-2.5 flex justify-between text-[11px] text-muted" aria-hidden="true">
      {/* Under 360px every second tick goes, so large text can't run them together; an odd count keeps the rest evenly placed. */}
      {ticks.map((t) => <span class="max-[360px]:even:hidden">{t}</span>)}
    </div>
  ) : (
    <div class="mt-2.5 flex max-sm:hidden" aria-hidden="true">
      {segments.map((s) => (
        <span class:list={[s.class.split(' ').filter((c) => c.startsWith('flex-')), 'flex min-w-0 flex-col gap-0.5 pr-1.5']}>
          <span class="mono text-[11px] text-muted">{s.range}</span>
          <span class="text-[11.5px] leading-[1.2] text-ink-soft hyphens-auto sm:text-[12.5px]">{s.label}</span>
        </span>
      ))}
    </div>
  )}
  {/* Phones: the bands are too narrow for their names, so they're listed under the bar instead, one per line. */}
  {!ticks && (
    <ul data-band-legend class="m-0 mt-3 flex list-none flex-col gap-1.5 p-0 sm:hidden" aria-hidden="true">
      {segments.map((s) => (
        <li data-band={s.label} class="group flex items-center gap-2.5 text-[14px] leading-[1.3] text-ink-soft data-current:font-semibold data-current:text-ink">
          <span class="invisible h-4 w-1 flex-none bg-coral group-data-current:visible"></span>
          <span class:list={['size-3 flex-none border border-ink', s.class.split(' ').filter((c) => c.startsWith('bg-'))]}></span>
          {/* Range and name share a line until large text makes the name too wide, then the name wraps under the range. */}
          <span class="flex min-w-0 flex-wrap items-center gap-x-2.5">
            <span class="mono min-w-[8ch] flex-none text-[11px] text-muted">{s.range}</span>
            <span class="min-w-0">{s.label}</span>
          </span>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  /* The bar is the size container, so the label can be clamped in bar widths (cqw) and its own width (%).
     Centred on the marker (-50%), but never more than 14px past either end of the bar: the card's 22px
     side padding leaves 8px clear of the card border. `--p` is the marker position, 0–100 (lib/band-scale.ts). */
  .bs-bar {
    container-type: inline-size;
  }
  .bs-label {
    --o: 14px;
    left: calc(var(--p) * 1%);
    translate: clamp(calc(var(--p) * -1cqw - var(--o)), -50%, calc((100 - var(--p)) * 1cqw + var(--o) - 100%)) 0;
  }
</style>
