---
/**
 * "What's happening in this test?": what the person does, step by step, and why. Sits below the test
 * (and its result) and above the FAQ and Sources. Copy lives in each test's data file (`happening`).
 * Links to the matching Learn article; the build fails if that article isn't published.
 */
import { getArticles } from '../../lib/learn/collection';
import type { Happening } from '../../data/shared';

interface Props {
  happening: Happening;
}
const { happening } = Astro.props;
const article = (await getArticles()).find((a) => a.id === happening.article);
if (!article) throw new Error(`WhatsHappening: no published Learn article "${happening.article}"`);
---
<section aria-labelledby="happening-title">
  <!-- Drafted: section heading given by Dev; the labels below are Drafted. -->
  <h2 id="happening-title" class="m-0 mb-3.5 text-[clamp(28px,3.4vw,34px)] font-semibold tracking-[-.04em]">What’s happening in this test?</h2>
  <ol class="m-0 list-none border-y border-ink p-0">
    {happening.steps.map((s, i) => (
      <li class:list={['flex gap-4 py-4', i > 0 && 'border-t border-line-inner']}>
        <span class="mono w-7 flex-none pt-[3px] text-[11px] text-blue" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <p class="m-0 text-[16.5px] leading-[1.6]"><b class="font-semibold">{s.title}</b> <span data-step={s.id}>{s.text}</span></p>
      </li>
    ))}
  </ol>
  <p class="mt-4 mb-0 text-[16.5px] leading-[1.6]"><b class="font-semibold">What can change your result:</b> {happening.change}</p>
  <p class="mt-3 mb-0 text-base leading-[1.6] text-ink-soft">
    Read more: <a href={`/learn/${article.id}/`} class="font-semibold text-ink underline underline-offset-[3px]">{article.data.title}</a>
  </p>
</section>
