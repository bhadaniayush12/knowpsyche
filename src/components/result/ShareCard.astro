---
/**
 * Share card shell. The page script calls `createShareCard(el).update(data)` from src/lib/share-card.ts,
 * which draws the canvas and wires the buttons. Copy from docs/design/Result.dc.html.
 */
import { CARD_H, CARD_W } from '../../lib/share-card';

const btn = 'inline-flex min-h-[50px] items-center px-5 py-3 text-base transition-colors duration-300 ease-house';
---
<section data-share aria-labelledby="share-title" class="flex flex-wrap items-center gap-[clamp(24px,4vw,40px)] border border-ink bg-lilac p-[clamp(22px,4vw,48px)]">
  <div class="mx-auto w-full max-w-[240px] flex-[0_1_240px]">
    <canvas
      width={CARD_W}
      height={CARD_H}
      class="block aspect-[9/16] h-auto w-full bg-lilac"
      role="img"
      aria-label="Your share card image"
    ></canvas>
  </div>
  <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-4">
    <div class="mono text-[11px] text-muted">Share card · made in your browser</div>
    <h2 id="share-title" class="m-0 text-[clamp(36px,4.4vw,60px)] leading-[.95] font-semibold tracking-[-.05em]">Challenge a <span class="serif text-blue">friend.</span></h2>
    <p class="m-0 max-w-[460px] text-[16.5px] leading-[1.6]">Send your score as an image. No account, and your result is never uploaded to us.</p>
    <div class="flex flex-wrap gap-2.5">
      <button type="button" data-share-action="share" class:list={[btn, 'border-0 bg-ink font-semibold text-paper hover:bg-blue']}>Share result</button>
      <button type="button" data-share-action="download" class:list={[btn, 'border border-ink bg-transparent text-ink hover:border-blue hover:text-blue']}>Download image</button>
      <button type="button" data-share-action="copy" class:list={[btn, 'border border-ink bg-transparent text-ink hover:border-blue hover:text-blue']}>Copy link</button>
      <slot />
    </div>
    <p data-share-status role="status" aria-live="polite" class="m-0 min-h-[1.5em] text-[14.5px] text-ink-soft"></p>
  </div>
</section>
