---
import SectionLabel from './ui/SectionLabel.astro';
import { getCollection } from 'astro:content';
import { DISCLAIMER, footerModes, homeTests } from '../data/home';
import { published } from '../lib/learn/articles';
import { MARK_RADIUS, MARK_SIZE, PSI_BOWL, PSI_STEM, PSI_WEIGHTS } from '../lib/brand/mark.js';

interface Props {
  /** `full` = Main design (homepage). `compact` = About/Method design (inner pages). */
  variant?: 'full' | 'compact';
}
const { variant = 'compact' } = Astro.props;

// Link groups for the full footer: all 7 tests, Learn (hub + the 3 most recently updated articles), the site.
const articles = published(await getCollection('learn')).slice(0, 3);
const columns = [
  {
    label: 'Tests',
    links: homeTests.map((t) => ({ href: t.href, label: t.name })),
  },
  {
    label: 'Learn',
    links: [{ href: '/learn/', label: 'Learn psychology' }, ...articles.map((a) => ({ href: `/learn/${a.id}/`, label: a.data.title }))],
  },
  {
    label: 'KnowPsyche',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/method/', label: 'How we build tests' },
      { href: '/privacy/', label: 'Privacy & disclaimer' },
      { href: '/terms/', label: 'Terms of use' },
      { href: '/contact/', label: 'Contact' },
    ],
  },
];

const compactLinks = [
  { href: '/tests/', label: 'Tests' },
  { href: '/learn/', label: 'Learn' },
  { href: '/about/', label: 'About' },
  { href: '/method/', label: 'Method' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
  { href: '/contact/', label: 'Contact' },
];
---
{variant === 'full' ? (
  <footer class="relative overflow-hidden bg-ink text-paper" data-motion-zone>
    <svg aria-hidden="true" viewBox="0 0 2880 120" preserveAspectRatio="none" class="pointer-events-none absolute left-0 top-0 h-[44px] w-[200%]">
      <path d="M0 0 L2880 0 L2880 40 C 2640 90, 2400 10, 2160 40 S 1680 90, 1440 40 S 960 -10, 720 40 S 240 90, 0 40 Z" fill="var(--color-paper)"></path>
    </svg>
    <div class="relative mx-auto flex max-w-[1200px] flex-col gap-[clamp(24px,3vw,36px)] px-[clamp(16px,3vw,40px)] pt-[clamp(64px,7vw,84px)] pb-6">
      {/* Wordmark and the four-word line. On hover the letters lift one after another and "psyche" leans. */}
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
        <div class="wordmark flex items-center gap-[.18em] text-[clamp(40px,10.5vw,124px)] leading-[.85] font-bold tracking-[-.065em]" aria-hidden="true">
          <svg viewBox={`0 0 ${MARK_SIZE} ${MARK_SIZE}`} class="size-[.82em] flex-none" aria-hidden="true">
            <rect width={MARK_SIZE} height={MARK_SIZE} rx={MARK_RADIUS} fill="var(--color-yellow)"></rect>
            <g fill="none" stroke="var(--color-ink)" stroke-linecap="round">
              <path stroke-width={PSI_WEIGHTS.bold.stem} d={PSI_STEM}></path>
              <path stroke-width={PSI_WEIGHTS.bold.bowl} d={PSI_BOWL}></path>
            </g>
          </svg>
          <span class="whitespace-nowrap">{[...'know'].map((ch, i) => <span class="wm-l" style={`--l:${i}`}>{ch}</span>)}<span class="wm-serif serif font-normal tracking-[-.03em] text-lilac-bright">{[...'psyche'].map((ch, i) => <span class="wm-l" style={`--l:${i + 4}`}>{ch}</span>)}</span></span>
        </div>
        <p class="m-0 pb-[.3em] text-[clamp(22px,2.4vw,30px)] leading-[1.1] font-semibold tracking-[-.03em]">
          Pause.{' '}<span class="serif font-normal text-lilac-bright">Breathe.</span>{' '}
          <span class="relative inline-block opacity-60">Overthink.<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" class="absolute -left-[2%] top-[44%] h-[.34em] w-[104%] overflow-visible"><path d="M2 12 C 80 4, 200 18, 298 8" class="strike" fill="none" stroke="var(--color-coral)" stroke-width="5" stroke-linecap="round"></path></svg></span>{' '}
          <span class="text-yellow">Reframe.</span>
        </p>
      </div>

      <div class="grid grid-cols-1 gap-x-8 gap-y-6 border-t border-paper/22 pt-[clamp(20px,2.4vw,28px)] sm:grid-cols-2 lg:grid-cols-[minmax(0,1.25fr)_repeat(3,minmax(0,1fr))]">
        <div class="flex min-w-0 flex-col gap-3 rounded-20 border border-paper/14 bg-paper/5 p-4 sm:col-span-2 lg:col-span-1">
          <div class="flex items-center justify-between gap-2.5">
            <span class="text-[16px] font-semibold">Before you go</span>
            <span class="text-[13px] opacity-75">pick a mode</span>
          </div>
          <div role="tablist" aria-label="Mode" class="mode-tabs grid grid-cols-3 gap-1 rounded-full bg-paper/8 p-1">
            {footerModes.map((m, i) => (
              <button
                type="button"
                role="tab"
                id={`mode-tab-${m.key}`}
                aria-controls={`mode-panel-${m.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-col={m.col}
                class="mode-tab min-h-11 rounded-full border-0 text-[14px] font-semibold transition-[background,color] duration-[600ms] ease-house"
                style={i === 0 ? { background: m.col, color: 'var(--color-ink)' } : { background: 'transparent', color: 'var(--color-paper)' }}
              >{m.label}</button>
            ))}
          </div>
          {footerModes.map((m, i) => (
            <div
              role="tabpanel"
              id={`mode-panel-${m.key}`}
              aria-labelledby={`mode-tab-${m.key}`}
              hidden={i !== 0}
              class="mode-panel flex min-h-[72px] items-center gap-3.5"
            >
              <div aria-hidden="true" class="flex size-16 flex-none items-center justify-center rounded-full border border-paper/18">
                <span class:list={['block size-11 rounded-full opacity-85', m.anim]} style={{ background: m.col }}></span>
              </div>
              <div class="fade text-[14.5px] leading-[1.5]">
                <b class="block text-[15.5px]">{m.title}</b>{m.note}
                {m.cta && <> <a href={m.cta.href} class="whitespace-nowrap font-semibold text-yellow hover:text-yellow">{m.cta.label} →</a></>}
              </div>
            </div>
          ))}
        </div>

        {columns.map((c) => (
          <nav aria-label={c.label} class="flex min-w-0 flex-col">
            <SectionLabel variant="plain" class="!opacity-75">{c.label}</SectionLabel>
            {c.links.map((l) => <a href={l.href} class="flex min-h-11 items-center py-0.5 text-[15px] lg:min-h-8 leading-[1.3] text-paper no-underline hover:text-yellow">{l.label}</a>)}
          </nav>
        ))}
      </div>

      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-t border-paper/12 pt-4 text-[13px]">
        <p class="m-0 max-w-[720px] leading-[1.55] opacity-80">{DISCLAIMER}</p>
        <div class="flex flex-wrap gap-x-6 gap-y-1 opacity-80">
          <span>© 2026 KnowPsyche</span>
          <a href="/report/" class="inline-flex min-h-11 items-center text-paper hover:text-yellow lg:min-h-8">Your report</a>
          <a href="#top" class="inline-flex min-h-11 items-center text-paper hover:text-yellow lg:min-h-8">Back to top ↑</a>
        </div>
      </div>
    </div>
  </footer>
) : (
  <footer class="border-t border-paper/15 bg-ink text-paper">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-[22px] px-[clamp(16px,3vw,40px)] py-9">
      <div class="flex flex-wrap items-center justify-between gap-5">
        <span class="text-[clamp(28px,3vw,40px)] font-semibold tracking-[-.04em]">Keep looking <span class="serif text-yellow">inward.</span></span>
        <nav aria-label="Footer" class="flex flex-wrap gap-x-[22px]">
          {compactLinks.map((l) => <a href={l.href} class="inline-flex min-h-11 min-w-11 items-center justify-center text-paper no-underline hover:text-yellow">{l.label}</a>)}
        </nav>
      </div>
      <p class="m-0 max-w-[760px] text-[13.5px] leading-[1.55] opacity-75">{DISCLAIMER}</p>
      <div class="mono flex flex-wrap justify-between gap-3 border-t border-paper/20 pt-4 text-[10.5px] opacity-70">
        <span class="inline-flex flex-wrap items-center gap-x-5"><span>© 2026 KnowPsyche</span><a href="/report/" class="inline-flex min-h-11 items-center text-paper hover:text-yellow">Your report</a></span><span class="inline-flex items-center">Educational self-reflection only · not a diagnostic tool</span>
      </div>
    </div>
  </footer>
)}

<script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.mode-tab'));
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        t.style.background = on ? (t.dataset.col ?? '') : 'transparent';
        t.style.color = on ? 'var(--color-ink)' : 'var(--color-paper)';
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  </script>
