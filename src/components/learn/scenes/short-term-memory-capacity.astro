---
/**
 * Scene 5: How much can your short-term memory hold?
 * Surprised character holding a few small number tiles, one tile slipping away.
 * Motion: the slipping tile, a small bounce.
 * Ink stroke: 3px, round joins and caps, token fills. aria-hidden.
 */
import Character from '../../Character.astro';

interface Props {
  size?: number;
  class?: string;
}

const { size = 150, class: className } = Astro.props;
---
<div class:list={['scene-short-term relative flex items-center justify-center', className]} aria-hidden="true">
  <Character
    skin="medium"
    hair={{ style: 'short', color: 'ink' }}
    shirt="yellow"
    expression="surprised"
    prop="none"
    size={size}
    class="scene-char"
  >
    {/* Left arm and hand supporting the tiles */}
    <g stroke="var(--color-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path
        style="fill:var(--color-yellow)"
        d="M76 316 C74 292 68 270 56 256 L34 264 C38 280 40 298 40 316 Z"
      />
      <circle cx="58" cy="248" r="11" fill="#E3B48C" />
    </g>

    {/* Right arm and hand trying to grasp the slipping tiles */}
    <g stroke="var(--color-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path
        style="fill:var(--color-yellow)"
        d="M164 316 C166 292 172 270 184 256 L206 264 C202 280 200 298 200 316 Z"
      />
      <circle cx="178" cy="248" r="11" fill="#E3B48C" />
    </g>

    {/* Held cluster of number tiles (e.g. 7, 4, 2, 8) */}
    <g class="scene-held-tiles" stroke-linecap="round" stroke-linejoin="round">
      {/* Tile 7 */}
      <g transform="translate(82, 226) rotate(-8)">
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-ink)" stroke="none" transform="translate(2, 2)" />
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-cream)" stroke="var(--color-ink)" stroke-width="2.5" />
        <text x="11" y="16" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" fill="var(--color-ink)" text-anchor="middle">7</text>
      </g>

      {/* Tile 4 */}
      <g transform="translate(106, 218) rotate(5)">
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-ink)" stroke="none" transform="translate(2, 2)" />
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-card)" stroke="var(--color-ink)" stroke-width="2.5" />
        <text x="11" y="16" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" fill="var(--color-ink)" text-anchor="middle">4</text>
      </g>

      {/* Tile 2 */}
      <g transform="translate(130, 228) rotate(-4)">
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-ink)" stroke="none" transform="translate(2, 2)" />
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-cream)" stroke="var(--color-ink)" stroke-width="2.5" />
        <text x="11" y="16" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" fill="var(--color-ink)" text-anchor="middle">2</text>
      </g>

      {/* Tile 8 */}
      <g transform="translate(100, 244) rotate(4)">
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-ink)" stroke="none" transform="translate(2, 2)" />
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="2.5" />
        <text x="11" y="16" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" fill="var(--color-ink)" text-anchor="middle">8</text>
      </g>
    </g>

    {/* One tile slipping away: tile "9" tumbling downwards */}
    <g class="scene-slipping-tile" stroke-linecap="round" stroke-linejoin="round">
      <g transform="translate(154, 238)">
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-ink)" stroke="none" transform="translate(2, 2)" />
        <rect x="0" y="0" width="22" height="22" rx="4" fill="var(--color-coral)" stroke="var(--color-ink)" stroke-width="2.5" />
        <text x="11" y="16" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" fill="var(--color-paper)" text-anchor="middle">9</text>
      </g>
      {/* Motion trail dashes */}
      <path d="M165 234 Q168 226 172 222" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="2 3" opacity="0.6" />
    </g>
  </Character>
</div>

<style>
  /* Disable default eyes blink so there are at most two animated parts: the slipping tile and the bounce. */
  :global(.scene-short-term .ch-eyes) {
    animation: none !important;
  }

  /* Animated part 1: The slipping tile */
  .scene-slipping-tile {
    transform-origin: 165px 249px;
    animation: tile-slip-anim 3.4s var(--ease-house) infinite paused;
  }

  /* Animated part 2: Small startled bounce of the character */
  :global(.scene-short-term .ch-float) {
    animation: char-bounce-anim 3.4s var(--ease-house) infinite paused;
  }

  /* Run animation only while character panel is on screen */
  :global(.ch-panel[data-on]) .scene-slipping-tile,
  :global(.scene-short-term .ch-panel[data-on] .ch-float) {
    animation-play-state: running;
  }

  :global([data-motion='paused']) .scene-slipping-tile,
  :global([data-motion='paused']) :global(.scene-short-term .ch-float) {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-slipping-tile,
    :global(.scene-short-term .ch-float) {
      animation: none !important;
    }
  }

  @keyframes tile-slip-anim {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    40% {
      transform: translate(6px, 16px) rotate(14deg);
      opacity: 1;
    }
    60% {
      transform: translate(12px, 36px) rotate(28deg);
      opacity: 0.85;
    }
    75% {
      transform: translate(16px, 52px) rotate(40deg);
      opacity: 0;
    }
    82% {
      transform: translate(0, -6px) rotate(-6deg);
      opacity: 0;
    }
    92%, 100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
  }

  @keyframes char-bounce-anim {
    0%, 38% {
      transform: translateY(0);
    }
    46% {
      transform: translateY(-4px);
    }
    54% {
      transform: translateY(1px);
    }
    62%, 100% {
      transform: translateY(0);
    }
  }
</style>
