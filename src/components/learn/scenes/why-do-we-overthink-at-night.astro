---
/**
 * Scene 9: Why do we overthink at night?
 * Tired, worried character sitting up in bed, a moon in a window, a loop of thought-scribble above the head.
 * Motion: scribble loop slowly turning, moon glow.
 * Ink stroke: 3px, round joins and caps, token fills. aria-hidden.
 */
import Character from '../../Character.astro';

interface Props {
  size?: number;
  class?: string;
}

const { size = 150, class: className } = Astro.props;
---
<div class:list={['scene-night relative flex items-center justify-center', className]} aria-hidden="true">
  <Character
    skin="medium"
    hair={{ style: 'curly', color: 'ink' }}
    shirt="blue"
    expression="worried"
    prop="none"
    size={size}
    class="scene-char"
  >
    {/* Arched window with moon and stars in upper-right */}
    <g class="scene-window" stroke-linecap="round" stroke-linejoin="round">
      {/* Window ink drop shadow */}
      <path
        d="M174 38 A22 22 0 0 1 218 38 L218 84 L174 84 Z"
        fill="var(--color-ink)"
        stroke="none"
      />
      {/* Window outer frame */}
      <path
        d="M172 36 A22 22 0 0 1 216 36 L216 82 L172 82 Z"
        fill="var(--color-ink-soft)"
        stroke="var(--color-ink)"
        stroke-width="3"
      />
      {/* Night sky pane */}
      <path
        d="M175 37 A19 19 0 0 1 213 37 L213 79 L175 79 Z"
        fill="var(--color-ink)"
        stroke="none"
      />

      {/* Moon glow halo */}
      <circle
        class="scene-moon-glow"
        cx="194"
        cy="44"
        r="14"
        fill="var(--color-yellow)"
        stroke="none"
      />

      {/* Crescent moon */}
      <path
        class="scene-moon"
        d="M200 37 A8.5 8.5 0 0 1 191 50 A7.5 7.5 0 1 0 200 37 Z"
        fill="var(--color-yellow)"
        stroke="var(--color-ink)"
        stroke-width="2"
      />

      {/* Small twinkling stars */}
      <path
        d="M182 34 L184 34 M183 33 L183 35"
        stroke="var(--color-paper)"
        stroke-width="1.8"
        stroke-linecap="round"
      />
      <path
        d="M207 68 L209 68 M208 67 L208 69"
        stroke="var(--color-paper)"
        stroke-width="1.8"
        stroke-linecap="round"
      />

      {/* Window mullion grid crossbars */}
      <line x1="175" y1="58" x2="213" y2="58" stroke="var(--color-ink)" stroke-width="2" />
      <line x1="194" y1="18" x2="194" y2="79" stroke="var(--color-ink)" stroke-width="2" />
      {/* Outer frame border */}
      <path
        d="M172 36 A22 22 0 0 1 216 36 L216 82 L172 82 Z"
        fill="none"
        stroke="var(--color-ink)"
        stroke-width="3"
      />
    </g>

    {/* Loop of thought-scribble above the head */}
    <g class="scene-scribble" stroke="var(--color-ink)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <path
        d="M106 48 C94 36 96 22 112 24 C128 26 138 40 126 56 C114 70 94 62 90 48 C86 32 108 20 126 22 C142 24 148 42 138 58 C128 72 106 72 98 56 C90 38 106 26 122 28 C136 30 142 46 132 58 C122 68 106 66 100 52 C96 38 110 30 124 32 C134 34 138 46 128 54 C118 62 108 58 106 48 Z"
      />
    </g>

    {/* Lead-in thought trail from head to scribble */}
    <path
      d="M116 66 Q118 72 120 78"
      fill="none"
      stroke="var(--color-ink)"
      stroke-width="2"
      stroke-dasharray="2 3"
      stroke-linecap="round"
      opacity="0.5"
    />

    {/* Tired under-eye creases to complement worried expression */}
    <path
      d="M93 147 Q100 151 107 147 M133 147 Q140 151 147 147"
      fill="none"
      stroke="var(--color-ink)"
      stroke-width="2"
      stroke-linecap="round"
      opacity="0.45"
    />

    {/* Bed duvet / covers across the waist (character sitting up in bed) */}
    <g class="scene-bed" stroke-linecap="round" stroke-linejoin="round">
      {/* Duvet ink drop shadow */}
      <rect x="18" y="258" width="204" height="60" rx="6" fill="var(--color-ink)" stroke="none" />
      {/* Duvet main quilt body */}
      <rect
        x="15"
        y="255"
        width="204"
        height="60"
        rx="6"
        fill="var(--color-tint-blue)"
        stroke="var(--color-ink)"
        stroke-width="3"
      />
      {/* Folded duvet turnover cuff along the top */}
      <rect
        x="15"
        y="251"
        width="204"
        height="18"
        rx="5"
        fill="var(--color-card)"
        stroke="var(--color-ink)"
        stroke-width="3"
      />
      {/* Quilted stitch rows across the blanket */}
      <line x1="24" y1="280" x2="210" y2="280" stroke="var(--color-line-card)" stroke-width="2" stroke-dasharray="4 4" />
      <line x1="24" y1="298" x2="210" y2="298" stroke="var(--color-line-card)" stroke-width="2" stroke-dasharray="4 4" />

      {/* Hands holding / clutching the top of the blanket */}
      <circle cx="82" cy="254" r="7.5" fill="#E3B48C" stroke="var(--color-ink)" stroke-width="2.5" />
      <path d="M78 252 Q82 249 86 252" fill="none" stroke="var(--color-ink)" stroke-width="2" />

      <circle cx="158" cy="254" r="7.5" fill="#E3B48C" stroke="var(--color-ink)" stroke-width="2.5" />
      <path d="M154 252 Q158 249 162 252" fill="none" stroke="var(--color-ink)" stroke-width="2" />
    </g>
  </Character>
</div>

<style>
  /* Disable body float and eyes blink so only two parts animate: scribble turn and moon glow. */
  :global(.scene-night .ch-float) {
    animation: none !important;
  }
  :global(.scene-night .ch-eyes) {
    animation: none !important;
  }

  /* Animated part 1: Scribble loop slowly turning */
  .scene-scribble {
    transform-origin: 116px 46px;
    animation: scribble-turn 14s linear infinite paused;
  }

  /* Animated part 2: Moon glow breathing */
  .scene-moon-glow {
    transform-origin: 194px 44px;
    animation: moon-glow 4s ease-in-out infinite paused;
  }

  /* Play animations only while in view */
  :global(.ch-panel[data-on]) :is(.scene-scribble, .scene-moon-glow) {
    animation-play-state: running;
  }

  :global([data-motion='paused']) :is(.scene-scribble, .scene-moon-glow) {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-scribble,
    .scene-moon-glow {
      animation: none !important;
    }
  }

  @keyframes scribble-turn {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes moon-glow {
    0%, 100% {
      opacity: 0.25;
      transform: scale(0.9);
    }
    50% {
      opacity: 0.75;
      transform: scale(1.25);
    }
  }
</style>
