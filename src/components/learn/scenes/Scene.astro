---
/**
 * Dynamic dispatcher for Learn article illustration scenes.
 * Given an article's scene slug, renders the matching illustration component.
 */
import WhatPsychologyTestsCanAndCantTellYou from './what-psychology-tests-can-and-cant-tell-you.astro';
import WhatAReactionTimeTestMeasures from './what-a-reaction-time-test-measures.astro';
import WhatIsTheEnneagram from './what-is-the-enneagram.astro';
import IsPhotographicMemoryReal from './is-photographic-memory-real.astro';
import ShortTermMemoryCapacity from './short-term-memory-capacity.astro';
import AttentionSpanMythsAndWhatHelps from './attention-span-myths-and-what-helps.astro';
import TheStroopEffectExplained from './the-stroop-effect-explained.astro';
import WhatIsEmotionalIntelligence from './what-is-emotional-intelligence.astro';
import WhyDoWeOverthinkAtNight from './why-do-we-overthink-at-night.astro';

export const scenes: Record<string, any> = {
  'what-psychology-tests-can-and-cant-tell-you': WhatPsychologyTestsCanAndCantTellYou,
  'what-a-reaction-time-test-measures': WhatAReactionTimeTestMeasures,
  'what-is-the-enneagram': WhatIsTheEnneagram,
  'is-photographic-memory-real': IsPhotographicMemoryReal,
  'short-term-memory-capacity': ShortTermMemoryCapacity,
  'attention-span-myths-and-what-helps': AttentionSpanMythsAndWhatHelps,
  'the-stroop-effect-explained': TheStroopEffectExplained,
  'what-is-emotional-intelligence': WhatIsEmotionalIntelligence,
  'why-do-we-overthink-at-night': WhyDoWeOverthinkAtNight,
};

export type SceneSlug = keyof typeof scenes;

interface Props {
  slug: string;
  size?: number;
  class?: string;
}

const { slug, size, class: className } = Astro.props;
const Component = scenes[slug];
---
{Component && <Component size={size} class={className} />}
