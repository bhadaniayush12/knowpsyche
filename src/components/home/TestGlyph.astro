---
import type { GlyphKey } from '../../data/home';

/** Small decorative drawing for each test card (from Main.dc.html). */
interface Props {
  glyph: GlyphKey;
}
const { glyph } = Astro.props;
const enDots = [
  [80, 4], [90.9, 8], [96.7, 18], [94.7, 29.5], [85.8, 37], [74.2, 37], [65.3, 29.5], [63.3, 18], [69.1, 8],
];
const pmCells = [
  [1, 1, true], [41, 1, false], [81, 1, false], [1, 29, false], [41, 29, true], [81, 29, false],
] as const;
---
{glyph === 'rt' && (
  <svg width="170" height="44" viewBox="0 0 180 48" aria-hidden="true"><path d="M0 24 H70 L80 6 L90 42 L100 24 H180" fill="none" stroke="var(--color-yellow)" stroke-width="2.6"></path><circle cx="100" cy="24" r="5" fill="var(--color-yellow)"></circle></svg>
)}
{glyph === 'en' && (
  <svg width="54" height="54" viewBox="58 0 44 44" aria-hidden="true">
    <circle cx="80" cy="21" r="17" fill="none" stroke="var(--color-violet)" stroke-width="1.6"></circle>
    <polygon points="80,4 94.7,29.5 65.3,29.5" fill="none" stroke="var(--color-violet)" stroke-width="1.6"></polygon>
    {enDots.map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.6" fill="var(--color-violet)"></circle>)}
  </svg>
)}
{glyph === 'pm' && (
  <svg width="110" height="50" viewBox="0 0 120 54" aria-hidden="true">
    {pmCells.map(([x, y, on]) => (
      <rect x={x} y={y} width="36" height="24" rx="4" fill={on ? '#C38D3D' : 'none'} stroke={on ? 'none' : '#C9BFA8'}></rect>
    ))}
  </svg>
)}
{glyph === 'nm' && (
  <span aria-hidden="true" class="text-[32px] font-semibold tracking-[.28em] text-teal-dark [perspective:200px]">{['4', '8', '2', '7', '1'].map((d, i) => <span class:list={['nm-d', i === 4 && 'opacity-30']} style={`--d:${i}`}>{d}</span>)}</span>
)}
{glyph === 'as' && (
  <svg width="54" height="54" viewBox="0 0 60 60" aria-hidden="true"><circle cx="30" cy="30" r="26" fill="none" stroke="var(--color-blue)" stroke-width="1.6"></circle><circle cx="30" cy="30" r="15" fill="none" stroke="var(--color-blue)" stroke-width="1.6"></circle><circle cx="30" cy="30" r="5" fill="var(--color-blue)"></circle><circle cx="50" cy="10" r="3" fill="var(--color-coral)"></circle></svg>
)}
{glyph === 'st' && (
  <span aria-hidden="true" class="text-[36px] font-bold tracking-[-.02em]"><span class="st-w st-w1 text-coral-ink">BLUE</span><span class="st-w st-w2 ml-2.5 text-blue">RED</span></span>
)}
{glyph === 'eq' && (
  <svg width="90" height="50" viewBox="0 0 96 54" aria-hidden="true"><circle cx="34" cy="27" r="22" fill="var(--color-coral)" fill-opacity=".35"></circle><circle cx="62" cy="27" r="22" fill="var(--color-violet)" fill-opacity=".35"></circle></svg>
)}
