---
import { PRIVATE_LINE } from '../../data/home';

// Drafted: the one line under "Your time". No comparison with other people, no verdict.
const kindLine = 'One try on this device. Sleep, focus and your screen all change it.';
---
<div class="mini-rt relative ml-auto w-full min-w-0 max-w-[480px] flex-[1_1_380px]">
  <div aria-hidden="true" class="absolute -top-[58px] left-[18px] hidden rotate-[-4deg] items-end gap-1.5 lg:flex">
    <span class="serif whitespace-nowrap text-2xl text-ink-soft">try it: 10 seconds</span>
    <svg aria-hidden="true" width="46" height="46" viewBox="0 0 46 46"><path d="M4 8 C 22 6, 36 16, 38 38 M30 31 L38 39 L44 30" fill="none" stroke="var(--color-ink-soft)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </div>
  <div
    aria-hidden="true"
    class="float absolute -top-[26px] right-0 z-[2] flex size-16 items-center justify-center rounded-18 bg-yellow pb-[5px] font-serif text-[44px] leading-none shadow-tile lg:-right-[18px]"
  >ψ</div>

  <div class="relative flex flex-col gap-3.5 rounded-24 border border-line-card bg-white p-[22px] shadow-lift">
    <div>
      <div class="text-[13px] font-medium text-muted">Mini test</div>
      <h2 class="mt-0.5 mb-0 text-[22px] font-semibold tracking-[-.02em]">How fast do you react?</h2>
    </div>

    <button
      type="button"
      class="rt-box relative flex h-[220px] w-full touch-manipulation items-center justify-center overflow-hidden rounded-18 border-0 text-center transition-[background] duration-[120ms]"
      style="background:var(--color-ink);color:var(--color-paper)"
    >
      {/* Full width, so changing text never moves the label sideways (no layout shift). */}
      <span class="rt-label pop relative flex w-full flex-col items-center gap-1.5 px-4" aria-live="polite">
        <span class="rt-big block w-full text-[clamp(34px,4.6vw,52px)] leading-[1.05] font-semibold tracking-[-.04em]">Tap to start</span>
        <span class="rt-small block w-full text-base opacity-[.92]">Then tap again the moment it turns green.</span>
      </span>
    </button>

    {/* After a try: your time, one kind line, and where to go next. One try only; nothing is kept. */}
    <div class="rt-result fade flex flex-col gap-2 rounded-14 bg-paper p-3.5" hidden>
      <p class="m-0 text-[17px] font-semibold">Your time: <span class="rt-ms"></span> ms</p>
      <p class="m-0 text-[15px] leading-[1.5] text-ink-soft">{kindLine}</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <button type="button" class="rt-again inline-flex min-h-11 items-center border border-ink bg-transparent px-4 text-[15px] font-semibold text-ink hover:border-blue hover:text-blue">Try again</button>
        <a href="/reaction-time-test/" class="inline-flex min-h-11 items-center whitespace-nowrap font-semibold">Take the full test →</a>
      </div>
    </div>
  </div>
  <p class="mt-3 mb-0 text-center text-[13.5px] text-ink-soft">{PRIVATE_LINE}</p>
</div>

<script>
  import { isGuess } from '../../lib/tests/reaction-time';

  type Phase = 'idle' | 'wait' | 'go' | 'early' | 'done';

  const root = document.querySelector<HTMLElement>('.mini-rt');
  if (root) {
    const box = root.querySelector<HTMLButtonElement>('.rt-box')!;
    const label = root.querySelector<HTMLElement>('.rt-label')!;
    const big = root.querySelector<HTMLElement>('.rt-big')!;
    const small = root.querySelector<HTMLElement>('.rt-small')!;
    const result = root.querySelector<HTMLElement>('.rt-result')!;
    const msEl = root.querySelector<HTMLElement>('.rt-ms')!;
    const again = root.querySelector<HTMLButtonElement>('.rt-again')!;
    const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // "Tap" on touch screens, "Click" with a mouse.
    const verb = window.matchMedia('(pointer: coarse)').matches ? 'Tap' : 'Click';
    const verbLower = verb.toLowerCase();

    // Plain labels for every state. "Wait for green." is Drafted.
    const look: Record<Phase, { bg: string; fg: string; big: string; small: string }> = {
      idle: { bg: 'var(--color-ink)', fg: 'var(--color-paper)', big: `${verb} to start`, small: `Then ${verbLower} again the moment it turns green.` },
      wait: { bg: 'var(--color-wait-red)', fg: '#FFFFFF', big: 'Wait...', small: 'Not yet.' },
      go: { bg: 'var(--color-mint-go)', fg: 'var(--color-ink)', big: 'Go!', small: 'Now!' },
      early: { bg: 'var(--color-yellow)', fg: 'var(--color-ink)', big: 'Too early, try again', small: 'Wait for green.' },
      done: { bg: 'var(--color-blue)', fg: '#FFFFFF', big: '', small: `${verb} to try again.` },
    };

    let phase: Phase = 'idle';
    let goAt = 0;
    let shownAt = 0;
    let frame = 0;

    const render = (ms = 0) => {
      const p = look[phase];
      box.style.background = p.bg;
      box.style.color = p.fg;
      big.textContent = phase === 'done' ? `${ms} ms` : p.big;
      small.textContent = p.small;
      if (!reduced()) {
        label.classList.remove('pop');
        void label.offsetWidth;
        label.classList.add('pop');
      }
      result.hidden = phase !== 'done';
      if (phase === 'done') msEl.textContent = String(ms);
    };

    /** One ripple from where the box was pressed (the centre for keys). Nothing with reduced motion. */
    const ripple = (x?: number, y?: number) => {
      if (reduced()) return;
      const r = box.getBoundingClientRect();
      const dot = document.createElement('span');
      dot.className = 'mrt-ripple';
      dot.setAttribute('aria-hidden', 'true');
      dot.style.left = `${(x ?? r.left + r.width / 2) - r.left}px`;
      dot.style.top = `${(y ?? r.top + r.height / 2) - r.top}px`;
      dot.addEventListener('animationend', () => dot.remove());
      box.prepend(dot);
    };

    // The go moment is checked every frame against performance.now(), so it doesn't drift.
    const tick = (now: number) => {
      if (phase !== 'wait') return;
      if (now >= goAt) {
        phase = 'go';
        render();
        shownAt = now;
        return;
      }
      frame = requestAnimationFrame(tick);
    };

    const startWait = () => {
      cancelAnimationFrame(frame);
      phase = 'wait';
      goAt = performance.now() + 1300 + Math.random() * 2400;
      render();
      frame = requestAnimationFrame(tick);
    };

    /** `t` = the input event's timestamp, so the time doesn't include our own work. */
    const press = (t: number) => {
      if (phase === 'wait') {
        cancelAnimationFrame(frame);
        phase = 'early';
        render();
      } else if (phase === 'go') {
        const ms = Math.round((t >= shownAt ? t : performance.now()) - shownAt);
        phase = isGuess(ms) ? 'early' : 'done';
        render(ms);
      } else {
        startWait();
      }
    };

    box.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      e.preventDefault();
      ripple(e.clientX, e.clientY);
      press(e.timeStamp);
    });
    box.addEventListener('keydown', (e) => {
      if (e.key !== ' ' && e.key !== 'Enter') return;
      e.preventDefault();
      if (e.repeat) return;
      ripple();
      press(e.timeStamp);
    });
    // Try again: back to the box, waiting for green straight away.
    again.addEventListener('click', () => {
      box.focus({ preventScroll: true });
      startWait();
    });

    render();
  }
</script>
