---
import { PRIVATE_LINE } from '../../data/home';
---
<div class="mini-rt relative ml-auto w-full min-w-0 max-w-[480px] flex-[1_1_380px]">
  <div aria-hidden="true" class="absolute -top-[58px] left-[18px] hidden rotate-[-4deg] items-end gap-1.5 lg:flex">
    <span class="serif whitespace-nowrap text-2xl text-ink-soft">try it: 10 seconds</span>
    <svg width="46" height="46" viewBox="0 0 46 46"><path d="M4 8 C 22 6, 36 16, 38 38 M30 31 L38 39 L44 30" fill="none" stroke="var(--color-ink-soft)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </div>
  <div
    aria-hidden="true"
    class="float absolute -top-[26px] right-0 z-[2] flex size-16 items-center justify-center rounded-18 bg-yellow pb-[5px] font-serif text-[44px] leading-none shadow-tile lg:-right-[18px]"
  >ψ</div>

  <div class="relative flex flex-col gap-3.5 rounded-24 border border-line-card bg-white p-[22px] shadow-lift">
    <div>
      <div class="text-[13px] font-medium text-muted">Mini test</div>
      <h2 class="mt-0.5 mb-0 text-[22px] font-semibold tracking-[-.02em]">How fast do you react?</h2>
    </div>

    <button
      type="button"
      class="rt-box flex h-[220px] w-full touch-manipulation items-center justify-center rounded-18 border-0 text-center transition-[background] duration-[120ms]"
      style="background:var(--color-ink);color:var(--color-paper)"
    >
      <span class="rt-label pop flex flex-col items-center gap-1.5 px-4" aria-live="polite">
        <span class="rt-big inline-block text-[clamp(34px,4.6vw,52px)] leading-[1.05] font-semibold tracking-[-.04em]">Tap to start</span>
        <span class="rt-small text-base opacity-[.92]">Then tap again the moment it turns green.</span>
      </span>
    </button>

    <div class="rt-result fade flex flex-col gap-2.5 rounded-14 bg-paper p-3.5" hidden>
      <div class="h-2 overflow-hidden rounded-full bg-line"><div class="rt-fill fill h-full rounded-full"></div></div>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="text-[15px]"><b class="rt-badge"></b> <span class="rt-text"></span></span>
        <a href="/reaction-time-test/" class="inline-flex min-h-11 items-center whitespace-nowrap font-semibold">Full test →</a>
      </div>
    </div>

    <div class="text-[13px] text-muted">Most people land between 200 and 300 milliseconds.</div>
  </div>
  <p class="mt-3 mb-0 text-center text-[13.5px] text-ink-soft">{PRIVATE_LINE}</p>
</div>

<script>
  import { fillPercent, getBand, isGuess } from '../../lib/tests/reaction-time';

  type Phase = 'idle' | 'wait' | 'go' | 'early' | 'done';

  const root = document.querySelector<HTMLElement>('.mini-rt');
  if (root) {
    const box = root.querySelector<HTMLButtonElement>('.rt-box')!;
    const label = root.querySelector<HTMLElement>('.rt-label')!;
    const big = root.querySelector<HTMLElement>('.rt-big')!;
    const small = root.querySelector<HTMLElement>('.rt-small')!;
    const result = root.querySelector<HTMLElement>('.rt-result')!;
    const fill = root.querySelector<HTMLElement>('.rt-fill')!;
    const badge = root.querySelector<HTMLElement>('.rt-badge')!;
    const text = root.querySelector<HTMLElement>('.rt-text')!;

    // "Tap" on touch screens, "Click" with a mouse.
    const verb = window.matchMedia('(pointer: coarse)').matches ? 'Tap' : 'Click';
    const verbLower = verb.toLowerCase();

    const look: Record<Phase, { bg: string; fg: string; big: string; small: string }> = {
      idle: { bg: 'var(--color-ink)', fg: 'var(--color-paper)', big: `${verb} to start`, small: `Then ${verbLower} again the moment it turns green.` },
      wait: { bg: 'var(--color-wait-red)', fg: '#FFFFFF', big: 'Wait…', small: 'Not yet.' },
      go: { bg: 'var(--color-mint-go)', fg: 'var(--color-ink)', big: `${verb}!`, small: 'Now!' },
      early: { bg: 'var(--color-yellow)', fg: 'var(--color-ink)', big: 'Too soon!', small: `${verb} to try again.` },
      done: { bg: 'var(--color-blue)', fg: '#FFFFFF', big: '', small: `${verb} to try again.` },
    };

    let phase: Phase = 'idle';
    let goAt = 0;
    let shownAt = 0;
    let frame = 0;

    const restart = (el: HTMLElement, cls: string) => {
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
    };

    const render = (ms = 0) => {
      const p = look[phase];
      box.style.background = p.bg;
      box.style.color = p.fg;
      big.textContent = phase === 'done' ? `${ms} ms` : p.big;
      small.textContent = p.small;
      restart(label, 'pop');
      big.classList.toggle('pulse', phase === 'done');
      result.hidden = phase !== 'done';
      if (phase === 'done') {
        const band = getBand(ms);
        badge.textContent = band.badge;
        text.textContent = band.text;
        fill.style.width = `${fillPercent(ms).toFixed(1)}%`;
        fill.style.background = ms <= 300 ? 'var(--color-teal)' : 'var(--color-coral)';
        restart(fill, 'fill');
        restart(result, 'fade');
      }
    };

    // The go moment is checked every frame against performance.now(), so it doesn't drift.
    const tick = (now: number) => {
      if (phase !== 'wait') return;
      if (now >= goAt) {
        phase = 'go';
        render();
        shownAt = performance.now();
        return;
      }
      frame = requestAnimationFrame(tick);
    };

    const startWait = () => {
      cancelAnimationFrame(frame);
      phase = 'wait';
      goAt = performance.now() + 1300 + Math.random() * 2400;
      render();
      frame = requestAnimationFrame(tick);
    };

    const press = () => {
      const now = performance.now();
      if (phase === 'wait') {
        cancelAnimationFrame(frame);
        phase = 'early';
        render();
      } else if (phase === 'go') {
        const ms = Math.round(now - shownAt);
        phase = isGuess(ms) ? 'early' : 'done';
        render(ms);
      } else {
        startWait();
      }
    };

    box.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
      press();
    });
    box.addEventListener('keydown', (e) => {
      if (e.key !== ' ' && e.key !== 'Enter') return;
      e.preventDefault();
      if (!e.repeat) press();
    });

    render();
  }
</script>
