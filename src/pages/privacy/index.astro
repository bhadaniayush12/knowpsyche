---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyPage from '../../components/policy/PolicyPage.astro';
import PolicySection from '../../components/policy/PolicySection.astro';

// Copy word for word from docs/design/Privacy.dc.html. Placeholders filled as Dev decided:
// date = 17 October 2026, the analytics sentence removed, a link to /terms/ added to section 06.
// Drafted (Task G2): the Analytics section, its contents entry and the Google line in the short version.
const title = 'Privacy & disclaimer | KnowPsyche';
const description =
  "Your test answers are scored in your browser and never sent to us. Here's what we keep, how Google Analytics works here, and why no result is a diagnosis.";

const summary = [
  'Tests are scored in your browser. Your answers and scores are not sent to us.',
  'No accounts, no sign-up, no email collection.',
  'Google Analytics counts page views, using cookies. You can turn this off.',
  'Nothing here is medical advice or a diagnosis.',
];
const toc = [
  { id: 'collect', label: 'What we collect' },
  // Drafted: contents entry for the saved-results section.
  { id: 'saved', label: 'Saved results on your device' },
  { id: 'analytics', label: 'Analytics' },
  { id: 'ads', label: 'Advertising' },
  { id: 'choices', label: 'Your choices' },
  { id: 'children', label: 'Children' },
  { id: 'disclaimer', label: 'Disclaimer' },
  { id: 'terms', label: 'Terms of use' },
  { id: 'changes', label: 'Changes & contact' },
];
---
<BaseLayout title={title} description={description} path="/privacy/" crumbs={[{ name: 'Privacy & disclaimer' }]}>
  <PolicyPage eyebrow="Privacy · disclaimer · terms · Last updated 17 October 2026" summary={summary} toc={toc}>
    <Fragment slot="title">Your mind is yours.<br /><span class="serif text-blue">So is your data.</span></Fragment>

    <PolicySection id="collect" toc={toc} color="text-blue" title="What we collect">
      <p class="pp">Your test answers and scores are calculated on your own device and are not sent to our servers. If you share a result, the share image is created in your browser too.</p>
      <p class="pp">Like most websites, our host may keep basic technical logs (such as IP address and browser type) to keep the site secure and working.</p>
    </PolicySection>

    <!-- Drafted: this whole section, including the button and status text. -->
    <PolicySection id="saved" toc={toc} color="text-teal-ink" title="Saved results on your device">
      <p class="pp">Nothing is saved unless you ask. Press "Save result" on any result screen to keep that result in this browser. It stays off until you press it.</p>
      <p class="pp">For each test you save, we keep the test name, the day, your band, the headline and the score you saw: all nine type scores for the Enneagram, the four area scores for emotional intelligence, the main number for the others. Never your answers, and never the time of each try.</p>
      <p class="pp">It sits in your browser's local storage on this device. It is never sent to us or anyone else, and we can't see it.</p>
      <p class="pp">Another phone, computer or browser has its own separate report, which starts empty. Private windows usually forget it when you close them.</p>
      <p class="pp">To clear it, press "Clear saved results" on any result screen, or the button below when something is saved. Clearing site data for knowpsyche.com in your browser settings removes it too. Saving a test again replaces its old result.</p>
      <div class="mt-2 flex items-center gap-3" data-privacy-clear-wrap hidden>
        <button type="button" data-privacy-clear-btn class="mono inline-flex min-h-11 items-center border border-ink bg-transparent px-4 text-xs text-ink hover:border-coral-ink hover:text-coral-ink">Clear saved results now</button>
        <span data-privacy-clear-status role="status" aria-live="polite" class="text-[14px] text-ink-soft"></span>
      </div>
    </PolicySection>

    <!-- Drafted (Task G2): this whole section. -->
    <PolicySection id="analytics" toc={toc} color="text-violet-ink" title="Analytics">
      <p class="pp">We use Google Analytics 4 to count page views, so we can see which pages people visit. It sets cookies in your browser, named _ga and _ga_*.</p>
      <p class="pp">Like any website you visit, Google may see your approximate location and your device or browser type. We have turned off Google signals and ad personalisation for Analytics.</p>
      <p class="pp">We never send your test answers, results, scores or the name you type in your report to Google Analytics, or anywhere else. Saved results stay on your device in local storage and are never sent.</p>
      <p class="pp">The Analytics data is kept for 2 months.</p>
      <p class="pp">To opt out, install <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener">Google's official opt-out browser add-on</a>. Blocking cookies in your browser settings works too. The tests will still work.</p>
    </PolicySection>

    <PolicySection id="ads" toc={toc} color="text-gold-ink" title="Cookies & advertising">
      <p class="pp">We don't show ads at the moment. If we add them, we'll update this page first and list the cookies they use.</p>
    </PolicySection>

    <PolicySection id="choices" toc={toc} color="text-coral-ink" title="Your choices">
      <p class="pp">You can block or delete cookies in your browser settings, or install Google's opt-out add-on described above. The tests will still work.</p>
    </PolicySection>

    <PolicySection id="children" toc={toc} color="text-teal-ink" title="Children">
      <p class="pp">KnowPsyche is not directed at children under 13, and we do not knowingly collect personal information from them.</p>
    </PolicySection>

    <PolicySection id="disclaimer" toc={toc} color="text-violet-ink" title="Disclaimer" boxed
      note="If you are struggling or feel unsafe, please contact local emergency services or a crisis helpline in your country.">
      <p class="pp">Everything on KnowPsyche is for education and self-reflection. Our tests are not clinical assessments, cannot diagnose any condition, and are not a substitute for advice from a qualified professional.</p>
    </PolicySection>

    <PolicySection id="terms" toc={toc} color="text-blue" title="Terms of use">
      <p class="pp">You're welcome to use and share the site for personal, non-commercial purposes. Please don't copy our questions, text or illustrations without permission. We work hard to keep content accurate, but it is provided as-is, without guarantees. Read the full <a href="/terms/">terms of use</a>.</p>
    </PolicySection>

    <PolicySection id="changes" toc={toc} color="text-gold-ink" title="Changes & contact">
      <p class="pp">If this policy changes, we'll update the date at the top of this page. Questions? Write to <a href="mailto:hello@knowpsyche.com">hello@knowpsyche.com</a> or use our <a href="/contact/">contact page</a>.</p>
    </PolicySection>
  </PolicyPage>
</BaseLayout>

<script>
  import { clearResults, hasSavedData, isStorageAvailable } from '../../lib/saved-results';
  import { $ } from '../../lib/test-ui';

  const wrap = $('[data-privacy-clear-wrap]');
  const btn = $('[data-privacy-clear-btn]');
  const status = $('[data-privacy-clear-status]');

  if (wrap && isStorageAvailable() && hasSavedData()) {
    wrap.hidden = false;
  }

  btn?.addEventListener('click', () => {
    clearResults();
    if (status) status.textContent = 'Saved results cleared from this device.';
    if (btn) btn.hidden = true;
  });
</script>
