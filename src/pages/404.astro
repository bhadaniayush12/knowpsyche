---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Character from '../components/Character.astro';
import TestGlyph from '../components/home/TestGlyph.astro';
import { homeTests } from '../data/home';

// Cloudflare Pages serves this for every unknown path, with a 404 status.
const title = 'Page not found | KnowPsyche';
const description =
  "This page doesn't exist. Head back to the KnowPsyche homepage or pick one of our free psychology tests.";

const pages = [
  { href: '/', label: 'Home' },
  { href: '/tests/', label: 'All tests' },
  { href: '/about/', label: 'About' },
  { href: '/method/', label: 'Method' },
  { href: '/contact/', label: 'Contact' },
];
---
<BaseLayout title={title} description={description} path="/404/" noindex>
  <div class="mx-auto flex max-w-[1200px] flex-col gap-[clamp(56px,7vw,96px)] px-[clamp(16px,3vw,40px)] pt-[clamp(56px,9vw,120px)] pb-20">
    <section class="flex flex-wrap items-center gap-x-[clamp(32px,5vw,72px)] gap-y-10">
      <div class="flex min-w-0 flex-[999_1_560px] flex-col items-start gap-6">
        <div class="mono text-[11px] text-muted">Error 404</div>
        <h1 class="m-0 max-w-[1000px] text-[clamp(46px,6.4vw,100px)] leading-[.92] font-semibold tracking-[-.055em]">Nothing to find here, <span class="serif text-blue">but plenty to try.</span></h1>
        <!-- Filled in by the script below when the URL looks like a typo of a real page. Space is reserved so nothing jumps. -->
        <p id="suggest" class="m-0 min-h-[58px] text-lg sm:min-h-[29px] leading-[1.6] text-ink-soft"></p>
        <div class="flex flex-wrap gap-2.5">
          <Button href="/">Go to the homepage</Button>
          <Button href="/tests/" variant="outline">Browse the tests →</Button>
        </div>
      </div>
      <!-- A lost character. Static SVG, so it shows without JavaScript; the motion only adds to it. -->
      <Character skin="medium" hair={{ style: 'short', color: 'ink' }} shirt="yellow" expression="puzzled" prop="map" size={240} class="flex-none rotate-[-1.5deg] max-sm:w-[200px]!">
        <g class="qm" fill="none" stroke="var(--color-ink)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M184 40 Q184 26 198 26 Q212 26 212 39 Q212 48 201 52 Q198 54 198 60 L198 64" />
          <circle cx="198" cy="76" r="2.6" fill="var(--color-ink)" stroke="none" />
        </g>
      </Character>
    </section>

    <section aria-labelledby="pick-title">
      <h2 id="pick-title" class="m-0 mb-[26px] text-[clamp(36px,4.4vw,60px)] leading-[.95] font-semibold tracking-[-.05em]">Pick a test <span class="serif text-violet">instead.</span></h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(270px,100%),1fr))] gap-4">
        {homeTests.map((t) => (
          <Card test={t}>
            <TestGlyph glyph={t.glyph} />
          </Card>
        ))}
      </div>
    </section>

    <section class="flex flex-col gap-4 border-t border-ink pt-8">
      <nav aria-label="Or go to" class="flex flex-wrap items-center gap-x-6">
        <span class="mono text-[11px] text-muted">Or go to</span>
        {pages.map((p) => <a href={p.href} class="inline-flex min-h-11 items-center text-[17px] font-medium">{p.label}</a>)}
      </nav>
      <p class="m-0 text-base leading-[1.6] text-ink-soft">Followed a broken link to get here? <a href="/contact/" class="underline">Tell us</a> and we'll fix it.</p>
    </section>
  </div>
</BaseLayout>

<script>
  import { suggestRoute } from '../lib/suggest';
  import { routes } from '../data/routes';

  // Reads the URL only. Nothing is sent anywhere.
  const match = suggestRoute(location.pathname, routes);
  const slot = document.getElementById('suggest');
  if (match && slot) {
    const link = document.createElement('a');
    link.href = match.href;
    link.className = 'font-semibold underline';
    link.textContent = match.label;
    slot.append('Did you mean the ', link, '?');
  }
</script>

<style>
  /* The question mark bobs and tilts gently, on the same terms as the character: only while on
     screen, never with reduced motion or "Pause motion". */
  .qm {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: qm-bob 4.2s var(--ease-house) infinite paused;
  }
  :global(.ch-panel[data-on]) .qm {
    animation-play-state: running;
  }
  :global([data-motion='paused']) .qm {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .qm {
      animation: none;
    }
  }
  @keyframes qm-bob {
    0%, 100% { transform: translateY(0) rotate(-6deg); }
    50% { transform: translateY(-5px) rotate(6deg); }
  }
</style>
