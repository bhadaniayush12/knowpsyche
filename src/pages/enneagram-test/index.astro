---
import TestPage from '../../layouts/TestPage.astro';
import ResultHeadline from '../../components/result/ResultHeadline.astro';
import ScoreVisual from '../../components/result/ScoreVisual.astro';
import WhatItMeans from '../../components/result/WhatItMeans.astro';
import TryThis from '../../components/result/TryThis.astro';
import BandsNote from '../../components/result/BandsNote.astro';
import ShareCard from '../../components/result/ShareCard.astro';
import TryAgain from '../../components/result/TryAgain.astro';
import NextTest from '../../components/result/NextTest.astro';
import CopyScores from '../../components/result/CopyScores.astro';
import SaveResult from '../../components/result/SaveResult.astro';
import ProgressTrail from '../../components/result/ProgressTrail.astro';
import { faqs, page, result, scale, sources, statements, tieBreak, types, ui, happening } from '../../data/tests/enneagram';

const btnSmall =
  'mono inline-flex min-h-11 items-center border border-ink bg-transparent px-4 text-xs text-ink hover:border-blue hover:text-blue disabled:cursor-default disabled:opacity-40 disabled:hover:border-ink disabled:hover:text-ink';
const choiceBtn =
  'en-choice flex min-h-14 items-center gap-3 rounded-14 border border-ink bg-paper px-4 py-3 text-left text-base font-medium text-ink transition-colors duration-200 hover:border-blue';
---
<TestPage
  title={page.title}
  description={page.description}
  path="/enneagram-test/"
  crumb={page.crumb}
  eyebrow={page.eyebrow}
  h1={page.h1}
  intro={page.intro}
  metaLine={page.metaLine}
  faqs={faqs}
  sources={sources}
  happening={happening}
>
  <div slot="stage" class="en-card rounded-[26px] border border-line-card bg-white p-[clamp(18px,4vw,40px)] shadow-[0_26px_54px_rgba(36,34,56,.12)]">
    {/* On phones the count gets its own row, so its wrapping never changes the card height. */}
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="mono flex min-w-0 flex-col gap-1 text-[11px] whitespace-nowrap">
        <span class="en-count text-muted">Statement 1 of {statements.length}</span>
        <span class="en-left text-muted">{ui.timeLeft(8)}</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" class:list={['en-back', btnSmall]} disabled>← Back</button>
        <button type="button" class:list={['en-restart', btnSmall]}>Restart ↺</button>
      </div>
    </div>
    <div class="mt-4 h-2 overflow-hidden rounded-full bg-line" role="progressbar" aria-label="Progress" aria-valuemin="0" aria-valuemax={statements.length} aria-valuenow="0">
      <div class="en-bar h-full rounded-full bg-blue transition-[width] duration-300 ease-house" style="width:0%"></div>
    </div>

    {/* The 45 statements */}
    <div class="en-main">
      <p class="en-milestone mt-3 mb-0 min-h-[3.1em] text-[14.5px] leading-[1.55] text-teal-ink sm:min-h-[1.55em]" aria-live="polite"></p>
      <p id="en-statement" class="en-statement mt-3 mb-0 min-h-[4.8em] text-[clamp(24px,3.4vw,40px)] leading-[1.2] font-semibold tracking-[-.03em] sm:min-h-[2.4em]" aria-live="polite">
        <span class="en-text inline-block">{statements[0].text}</span>
      </p>
      <div role="group" aria-labelledby="en-statement" class="mt-6 grid gap-2 sm:grid-cols-5">
        {scale.map((label, i) => (
          <button
            type="button"
            data-value={i + 1}
            aria-pressed="false"
            aria-keyshortcuts={String(i + 1)}
            class="en-answer flex min-h-14 items-center gap-3 rounded-14 border border-ink bg-paper px-4 py-3 text-left text-base font-medium text-ink transition-colors duration-200 hover:border-blue sm:flex-col sm:justify-center sm:gap-1.5 sm:px-2 sm:text-center"
          >
            <span class="mono inline-flex size-7 flex-none items-center justify-center rounded-lg border border-current text-xs" aria-hidden="true">{i + 1}</span>
            <span>{label}</span>
          </button>
        ))}
      </div>
    </div>

    {/* Tie-break round: shown only when 2 or 3 types are within a point. Focus moves here (not to an answer), so a stray Enter answers nothing. */}
    <div class="en-tb" tabindex="-1" hidden>
      <p class="mt-3 mb-0 text-[14.5px] leading-[1.55] text-teal-ink">{tieBreak.intro}</p>
      <p id="en-tb-prompt" class="en-tb-prompt mt-3 mb-0 text-[clamp(24px,3.4vw,40px)] leading-[1.2] font-semibold tracking-[-.03em]" aria-live="polite"></p>
      <div role="group" aria-labelledby="en-tb-prompt" class="mt-6 grid gap-2 sm:grid-cols-2">
        {['a', 'b'].map((c, i) => (
          <button type="button" data-choice={c} aria-pressed="false" aria-keyshortcuts={String(i + 1)} class={choiceBtn}>
            <span class="mono inline-flex size-7 flex-none items-center justify-center rounded-lg border border-current text-xs" aria-hidden="true">{i + 1}</span>
            <span class="en-choice-text"></span>
          </button>
        ))}
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
        <button type="button" data-choice="same" aria-pressed="false" aria-keyshortcuts="3" class:list={[choiceBtn, 'min-h-11 py-2 text-[15px]']}>
          <span class="mono inline-flex size-6 flex-none items-center justify-center rounded-md border border-current text-[11px]" aria-hidden="true">3</span>
          <span>{tieBreak.same}</span>
        </button>
        <button type="button" class="en-tb-skip inline-flex min-h-11 items-center border-0 bg-transparent px-1 text-[15px] text-ink-soft underline underline-offset-4 hover:text-blue">{tieBreak.skip}</button>
      </div>
    </div>
  </div>

  <Fragment slot="result">
    <div class="flex flex-col gap-3">
      <ResultHeadline />
      <p data-r="strength" class="m-0 inline-flex max-w-[640px] self-start rounded-full bg-tint-blue px-3.5 py-1.5 text-[14.5px] text-ink" hidden></p>
    </div>

    <ScoreVisual>
      <div class="flex flex-wrap items-stretch gap-[clamp(24px,4vw,40px)]">
        <div class="flex min-w-0 flex-[1_1_280px] flex-col justify-between gap-6 border border-ink bg-ink p-[26px] text-paper shadow-[10px_10px_0_var(--color-yellow)]">
          <div class="mono text-[11px] opacity-80">Your type</div>
          <div>
            <div data-r="badge" class="text-[clamp(72px,10vw,128px)] leading-[.85] font-semibold tracking-[-.06em]"></div>
            <div data-r="badge-name" class="serif mt-3 text-[clamp(24px,2.6vw,30px)] leading-[1.1] text-yellow"></div>
          </div>
        </div>
        <div class="flex min-w-0 flex-[999_1_480px] flex-col gap-3 border border-ink bg-card p-[22px]">
          <div class="mono flex flex-wrap justify-between gap-2 text-[11px]">
            <span>Your scores · out of 25</span>
            <span data-r="bar-key" class="flex gap-3">
              <span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 bg-blue" aria-hidden="true"></span>Main</span>
              <span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 bg-violet" aria-hidden="true"></span>Wing</span>
            </span>
          </div>
          <ol data-r="bars" class="m-0 flex list-none flex-col gap-2.5 p-0"></ol>
          <div class="mt-1 flex flex-wrap items-center justify-between gap-2 border-t border-line-inner pt-3">
            <button type="button" data-r="toggle-bars" aria-expanded="false" class="inline-flex min-h-11 items-center border-0 bg-transparent px-0 text-[15px] font-semibold text-ink underline underline-offset-4 hover:text-blue">{ui.showAll}</button>
            <CopyScores label={ui.copyScores} />
          </div>
        </div>
      </div>
    </ScoreVisual>

    <WhatItMeans change={result.change} />

    <div data-r="details" class="grid gap-4"></div>

    <details class="en-nine border border-ink bg-card">
      <summary class="flex min-h-12 items-center justify-between gap-3 px-4 py-3 text-[17px] font-semibold">
        <span>{ui.nineTypes}</span><span class="plus mono text-xs" aria-hidden="true">+</span>
      </summary>
      <table class="w-full table-fixed border-collapse text-left text-[13.5px] leading-[1.4] sm:text-[14.5px] sm:leading-[1.45]">
        <colgroup><col class="w-[36%]" /><col class="w-[32%]" /><col class="w-[32%]" /></colgroup>
        <thead class="bg-lilac">
          <tr class="border-t border-ink">
            <th scope="col" class="p-2.5 font-semibold sm:p-3">Type</th>
            <th scope="col" class="border-l border-ink p-2.5 font-semibold sm:p-3">Core desire</th>
            <th scope="col" class="border-l border-ink p-2.5 font-semibold sm:p-3">Core fear</th>
          </tr>
        </thead>
        <tbody>
          {types.map((t) => (
            <tr data-type={t.n} class="en-row border-t border-ink">
              <th scope="row" class="p-2.5 align-top font-semibold break-words sm:p-3"><span class="mono mr-1.5 text-[11px] text-muted">{t.n}</span>{t.name.replace(/^The /, '')}</th>
              <td class="border-l border-ink p-2.5 align-top break-words sm:p-3">{t.desire}</td>
              <td class="border-l border-ink p-2.5 align-top break-words sm:p-3">{t.fear}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>

    <TryThis />

    <BandsNote />

    <SaveResult testId="enneagram" />

    <ShareCard>
      <TryAgain />
    </ShareCard>

    <ProgressTrail variant="card" current="enneagram" />

    <NextTest from="/enneagram-test/" line={result.nextLine} learn={result.learn} />
  </Fragment>
</TestPage>

<style is:global>
  .en-answer[aria-pressed='true'],
  .en-choice[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .en-answer.en-chosen,
  .en-choice.en-chosen { background: var(--color-blue); color: #fff; border-color: var(--color-blue); animation: en-pulse .2s var(--ease-house); }
  .en-in { animation: en-in .28s var(--ease-house); }
  .en-row[data-mine] { background: var(--color-tint-blue); }
  .en-row[data-mine] th { color: var(--color-blue); }
  [data-r='bars'] li[data-extra] { display: none; }
  [data-r='bars'][data-all] li[data-extra] { display: flex; }
  @keyframes en-pulse { 0% { transform: scale(1); } 45% { transform: scale(1.04); } 100% { transform: scale(1); } }
  @keyframes en-in { from { opacity: 0; transform: translateX(18px); } to { opacity: 1; transform: none; } }
</style>

<script>
  import { milestones, result as copy, statements, tieBreak as tbCopy, tieBreakLines, typeStep, types, ui, wingLines, type TypeNumber } from '../../data/tests/enneagram';
  import {
    applyTieBreak,
    barRoles,
    getResult,
    needsTieBreak,
    resultStrength,
    tieBreakQuestions,
    topStatements,
    wingLabel,
    type Choice,
    type EnneagramResult,
    type TieBreakQuestion,
  } from '../../lib/tests/enneagram';
  import { createShareCard } from '../../lib/share-card';
  import { initSaveOptIn } from '../../lib/saved-results';
  import { $, $$, bindCopy, guardLeave, onScreen, today } from '../../lib/test-ui';

  const card = $('.en-card');
  const count = $('.en-count');
  const left = $('.en-left');
  const bar = $('.en-bar');
  const progress = $('[role=progressbar]', card);
  const main = $('.en-main');
  const milestone = $('.en-milestone');
  const text = $('.en-text');
  const answerButtons = $$<HTMLButtonElement>('.en-answer');
  const tb = $('.en-tb');
  const tbPrompt = $('.en-tb-prompt');
  const tbButtons = $$<HTMLButtonElement>('.en-choice');
  const back = $<HTMLButtonElement>('.en-back');
  const resultEl = $('[data-result]');
  const r = (key: string) => $(`[data-r="${key}"]`, resultEl);
  const share = createShareCard($('[data-share]'));
  const saveOptIn = initSaveOptIn($('[data-save-optin]', resultEl));
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const cardVisible = onScreen(card);

  const TOTAL = statements.length;
  const PULSE_MS = 200;
  /** 8 minutes over 45 statements. */
  const SECONDS_EACH = (8 * 60) / TOTAL;
  const typeInfo = (n: TypeNumber) => types[n - 1];

  // Answers live only in these variables. Nothing is stored or sent.
  let answers: (number | null)[] = Array(TOTAL).fill(null);
  let index = 0;
  let locked = false;
  let done = false;
  let phase: 'statements' | 'tiebreak' = 'statements';
  let pending: EnneagramResult | null = null;
  let questions: TieBreakQuestion[] = [];
  let choices: (Choice | null)[] = [];
  let tbIndex = 0;
  let shown: EnneagramResult | null = null;

  const answeredCount = () => answers.filter((a) => a !== null).length;

  const slideIn = (el: HTMLElement) => {
    if (reducedMotion.matches) return;
    el.classList.remove('en-in');
    void el.offsetWidth;
    el.classList.add('en-in');
  };

  const render = (animate = false) => {
    const n = answeredCount();
    bar.style.width = `${((n / TOTAL) * 100).toFixed(2)}%`;
    progress.setAttribute('aria-valuenow', String(n));
    main.hidden = phase !== 'statements';
    tb.hidden = phase !== 'tiebreak';
    back.disabled = phase === 'statements' && index === 0;

    if (phase === 'statements') {
      count.textContent = `Statement ${index + 1} of ${TOTAL}`;
      left.textContent = done ? '' : ui.timeLeft(Math.ceil(((TOTAL - index) * SECONDS_EACH) / 60));
      milestone.textContent = [...milestones].reverse().find((m) => n >= m.at)?.text ?? '';
      text.textContent = statements[index].text;
      answerButtons.forEach((b) => {
        b.classList.remove('en-chosen');
        b.setAttribute('aria-pressed', String(Number(b.dataset.value) === answers[index]));
      });
      if (animate) slideIn(text);
    } else {
      const q = questions[tbIndex];
      count.textContent = `Tie-break ${tbIndex + 1} of ${questions.length}`;
      left.textContent = ui.timeLeft(1);
      tbPrompt.textContent = tbCopy.prompts[q.motive];
      const [ba, bb] = tbButtons;
      $('.en-choice-text', ba).textContent = tieBreakLines[q.a][q.motive];
      $('.en-choice-text', bb).textContent = tieBreakLines[q.b][q.motive];
      tbButtons.forEach((b) => {
        b.classList.remove('en-chosen');
        b.setAttribute('aria-pressed', String(b.dataset.choice === choices[tbIndex]));
      });
      if (animate) slideIn(tbPrompt);
    }
  };

  /** Pulse the chosen button, then run `next`. Instant with reduced motion. Locks input meanwhile. */
  const confirm = (btn: HTMLButtonElement, group: HTMLButtonElement[], next: () => void) => {
    if (reducedMotion.matches) {
      next();
      return;
    }
    locked = true;
    group.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    btn.classList.add('en-chosen');
    window.setTimeout(() => {
      locked = false;
      next();
      // An answer given during the pulse counts for the next statement or tie-break instead of being dropped.
      if (queued) {
        const run = queued;
        queued = null;
        run();
      }
    }, PULSE_MS);
  };

  /** The latest answer pressed while the previous one was still pulsing. */
  let queued: (() => void) | null = null;

  const choose = (value: number) => {
    if (done || phase !== 'statements') return;
    if (locked) {
      queued = () => choose(value);
      return;
    }
    answers[index] = value;
    confirm(answerButtons[value - 1], answerButtons, () => {
      if (index === TOTAL - 1) {
        afterStatements();
        return;
      }
      index += 1;
      render(true);
    });
  };

  const afterStatements = () => {
    const res = getResult(answers as number[]);
    if (needsTieBreak(res)) {
      pending = res;
      questions = tieBreakQuestions(res.top);
      choices = Array(questions.length).fill(null);
      tbIndex = 0;
      phase = 'tiebreak';
      render(true);
      focusTieBreak();
      return;
    }
    finish(res);
  };

  const chooseTieBreak = (c: Choice) => {
    if (done || phase !== 'tiebreak') return;
    if (locked) {
      queued = () => chooseTieBreak(c);
      return;
    }
    choices[tbIndex] = c;
    const btn = tbButtons.find((b) => b.dataset.choice === c)!;
    confirm(btn, tbButtons, () => {
      if (tbIndex === questions.length - 1) {
        finish(applyTieBreak(pending!, choices as Choice[]));
        return;
      }
      tbIndex += 1;
      render(true);
      focusTieBreak();
    });
  };

  /** Keys 1-3 keep working from here (it's inside the card); Enter does nothing. */
  const focusTieBreak = () => tb.focus({ preventScroll: true });

  const goBack = () => {
    if (locked || done) return;
    if (phase === 'tiebreak') {
      if (tbIndex > 0) tbIndex -= 1;
      else phase = 'statements'; // back to statement 45
    } else if (index > 0) {
      index -= 1;
    }
    render(true);
  };

  const reset = () => {
    answers = Array(TOTAL).fill(null);
    index = 0;
    locked = false;
    queued = null;
    done = false;
    phase = 'statements';
    pending = null;
    shown = null;
    resultEl.hidden = true;
    saveOptIn.reset();
    setTypeStep(false);
    render();
  };

  /** "What's happening": after a decided tie-break the main type may not be the highest bar, so that step says so. */
  const typeStepEl = document.querySelector<HTMLElement>('[data-step="your-type"]');
  const setTypeStep = (byTieBreak: boolean) => {
    if (typeStepEl) typeStepEl.textContent = `${byTieBreak ? typeStep.byTieBreak : typeStep.main} ${typeStep.wing}`;
  };

  // ---------- Result ----------
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', txt = '') => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (txt) e.textContent = txt;
    return e;
  };
  const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
  const short = (n: TypeNumber) => typeInfo(n).name.replace(/^The /, '');
  /** "a 4" but "an 8". */
  const an = (n: number | string) => (String(n).startsWith('8') ? 'an' : 'a');
  const wingWords = (wings: TypeNumber[]) => `with ${an(wings[0])} ${wings.join(' or ')} wing`;
  const label = (n: TypeNumber) => `${n}`;

  const renderBars = (res: EnneagramResult) => {
    // Even scores: no "Main" or "Wing" tags and every bar neutral, since no single type stood out.
    const roles = barRoles(res);
    const isMain = (t: TypeNumber) => Number(roles[t] === 'main');
    const list = r('bars');
    // Highest first; on equal scores the main type (e.g. the tie-break winner) goes first.
    const ordered = [...res.ranked].sort((x, y) => y.sum - x.sum || isMain(y.type) - isMain(x.type));
    list.replaceChildren(
      ...ordered.map(({ type, sum, pct }, i) => {
        const role = roles[type];
        const li = el('li', 'flex flex-col gap-1');
        li.dataset.role = role;
        // Top 3, plus any main type or wing further down, show by default; the rest sit behind "Show all 9".
        if (i >= 3 && role === 'none') li.dataset.extra = '';
        const row = el('div', 'flex items-baseline justify-between gap-3 text-[14.5px]');
        const name = el('span', 'min-w-0');
        name.append(el('b', 'font-semibold', `Type ${type}`), ` · ${short(type)}`);
        if (role !== 'none') name.append(el('span', 'mono ml-2 text-[10px] text-muted', role === 'main' ? 'Main' : 'Wing'));
        row.append(name, el('span', 'mono flex-none text-[12px]', `${sum}/25`));
        const track = el('div', 'h-2.5 overflow-hidden rounded-full bg-line');
        track.setAttribute('role', 'img');
        track.setAttribute('aria-label', `Type ${type}: ${sum} out of 25`);
        const fill = el('div', 'fill h-full rounded-full');
        fill.style.width = `${Math.max(pct, 1)}%`;
        fill.style.background = role === 'main' ? 'var(--color-blue)' : role === 'wing' ? 'var(--color-violet)' : 'var(--color-muted)';
        track.append(fill);
        li.append(row, track);
        return li;
      }),
    );
    // With even scores every type matters, so show all 9. Nothing is marked, so the Main/Wing key goes too.
    setAllBars(res.kind === 'even');
    r('toggle-bars').hidden = res.kind === 'even';
    r('bar-key').hidden = res.kind === 'even';
  };

  const setAllBars = (all: boolean) => {
    r('bars').toggleAttribute('data-all', all);
    const t = r('toggle-bars');
    t.setAttribute('aria-expanded', String(all));
    t.textContent = all ? ui.showTop : ui.showAll;
  };

  /** "Why this type?": the statements for `n` the person rated highest. */
  const whyBlock = (n: TypeNumber) => {
    const box = el('div', 'flex flex-col gap-2 border-l-[3px] border-blue pl-3.5');
    box.append(el('h4', 'm-0 text-[16px] font-semibold', ui.whyTitle), el('p', 'm-0 text-[14.5px] text-ink-soft', ui.whyIntro));
    const ul = el('ul', 'm-0 flex list-none flex-col gap-1.5 p-0');
    for (const i of topStatements(answers as number[], n)) {
      const li = el('li', 'flex flex-wrap items-baseline justify-between gap-x-3 text-[15.5px] leading-[1.5]');
      li.append(el('span', 'min-w-0', `“${statements[i].text}”`), el('span', 'mono text-[10.5px] text-muted', scaleLabel(answers[i]!)));
      ul.append(li);
    }
    box.append(ul);
    return box;
  };
  const scaleLabels = $$('.en-answer span:last-child').map((s) => s.textContent ?? '');
  const scaleLabel = (v: number) => scaleLabels[v - 1];

  /** Full card for one type: why, at your best / under stress, wing line(s), desire and fear. */
  const detailCard = (n: TypeNumber, wings: TypeNumber[], opts: { template: boolean; why: boolean }) => {
    const t = typeInfo(n);
    const box = el('article', 'flex flex-col gap-4 border border-ink bg-card p-[clamp(18px,3vw,26px)]');
    const head = el('div', 'flex flex-wrap items-baseline justify-between gap-2');
    head.append(el('h3', 'm-0 text-[22px] font-semibold tracking-[-.03em]', `Type ${n}: ${t.name}`), el('span', 'mono text-[11px] text-blue', wingLabel(n, wings)));
    box.append(head);
    if (opts.template) box.append(el('p', 'm-0 text-[16px] leading-[1.6]', `${t.drive} At your best you're ${t.best}. Watch for ${lower(t.stress)}.`));
    if (opts.why) box.append(whyBlock(n));

    const cols = el('div', 'grid gap-3 sm:grid-cols-2');
    const best = el('div', 'flex flex-col gap-1.5 bg-tint-teal p-4');
    best.append(el('h4', 'mono m-0 text-[11px] font-medium text-teal-ink', 'At your best'), el('p', 'm-0 text-[15.5px] leading-[1.55]', `${t.strengths}.`));
    const stress = el('div', 'flex flex-col gap-1.5 bg-tint-ochre p-4');
    stress.append(el('h4', 'mono m-0 text-[11px] font-medium text-gold-ink', 'Under stress'), el('p', 'm-0 text-[15.5px] leading-[1.55]', t.overfire));
    cols.append(best, stress);
    box.append(cols);

    for (const w of wings) box.append(el('p', 'serif m-0 text-[20px] leading-[1.25] text-violet-ink', wingLines[`${n}w${w}`]));
    const dl = el('dl', 'm-0 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[14.5px]');
    dl.append(el('dt', 'mono pt-0.5 text-[10.5px] text-muted', 'Core desire'), el('dd', 'm-0', t.desire));
    dl.append(el('dt', 'mono pt-0.5 text-[10.5px] text-muted', 'Core fear'), el('dd', 'm-0', t.fear));
    box.append(dl);
    return box;
  };

  /** Runner-up, folded away: for a close call, people should read both. */
  const runnerUp = (n: TypeNumber, wings: TypeNumber[]) => {
    const d = el('details', 'border border-ink bg-paper');
    const s = el('summary', 'flex min-h-12 items-center justify-between gap-3 px-4 py-3 text-[17px] font-semibold');
    s.append(el('span', '', `${ui.runnerUp(n)}: ${typeInfo(n).name}`), el('span', 'plus mono text-xs', '+'));
    s.lastElementChild!.setAttribute('aria-hidden', 'true');
    const inner = el('div', 'border-t border-ink');
    const c = detailCard(n, wings, { template: true, why: true });
    c.classList.remove('border');
    inner.append(c);
    d.append(s, inner);
    return d;
  };

  /** Wings for any type, from the full scores (runner-ups aren't in `res.wings`). */
  const wingsOf = (res: EnneagramResult, n: TypeNumber): TypeNumber[] => {
    if (res.wings[n]) return res.wings[n]!;
    const sum = (t: TypeNumber) => res.ranked.find((x) => x.type === t)!.sum;
    const a = (n === 1 ? 9 : n - 1) as TypeNumber;
    const b = (n === 9 ? 1 : n + 1) as TypeNumber;
    return sum(a) === sum(b) ? [a, b] : [sum(a) > sum(b) ? a : b];
  };

  const finish = (res: EnneagramResult) => {
    done = true;
    shown = res;
    phase = 'statements';
    index = TOTAL - 1;
    render();
    const [first, second] = res.top;
    const t1 = typeInfo(first);
    const w1 = res.wings[first] ?? [];
    const meaning = r('meaning');
    const details = r('details');
    const strength = r('strength');
    meaning.replaceChildren();
    strength.hidden = true;
    details.hidden = res.kind === 'even';
    let tip = t1.tip;

    if (res.kind === 'clear') {
      const s = resultStrength(res);
      r('eyebrow').textContent = `Your result · Enneagram · ${wingLabel(first, w1)}`;
      r('headline').textContent = `You're most likely a Type ${first}: ${t1.name}`;
      r('badge').textContent = w1.length === 1 ? wingLabel(first, w1) : `Type ${first}`;
      r('badge-name').textContent = t1.name;
      meaning.append("You're most likely a ", el('b', 'font-semibold', `Type ${first}: ${t1.name}`), ` ${wingWords(w1)}. ${t1.drive} At your best you're ${t1.best}. Watch for ${lower(t1.stress)}.`);
      strength.textContent = s.label === 'clear' ? ui.clearLead(s.gap, s.next) : s.label === 'close' ? ui.closeCall(s.gap, s.next) : ui.settled(s.next);
      strength.hidden = false;
      const blocks: HTMLElement[] = [detailCard(first, w1, { template: false, why: true })];
      if (s.label !== 'clear') blocks.push(runnerUp(s.next, wingsOf(res, s.next)));
      details.replaceChildren(...blocks);
    } else if (res.kind === 'tie') {
      const t2 = typeInfo(second);
      const w2 = res.wings[second] ?? [];
      r('eyebrow').textContent = `Your result · Enneagram · ${label(first)} or ${label(second)}`;
      r('headline').textContent = `You may be ${an(first)} ${first} or ${an(second)} ${second}`;
      r('badge').textContent = `${first} or ${second}`;
      r('badge-name').textContent = `${short(first)} or ${short(second)}`;
      meaning.append(`You may be ${an(first)} ${first} or ${an(second)} ${second}. `);
      meaning.append(el('b', 'font-semibold', `Type ${first}: ${t1.name}`), ` ${wingWords(w1)}, or `);
      meaning.append(el('b', 'font-semibold', `Type ${second}: ${t2.name}`), ` ${wingWords(w2)}. Both are described below.`);
      details.replaceChildren(detailCard(first, w1, { template: true, why: true }), detailCard(second, w2, { template: true, why: true }));
    } else {
      r('eyebrow').textContent = 'Your result · Enneagram';
      r('headline').textContent = 'Your scores are very even';
      r('badge').textContent = 'Even';
      r('badge-name').textContent = 'No single type stood out';
      meaning.textContent = copy.evenMeaning;
      // No single type stands out, so no type cards: "The nine types" list below has every description.
      details.replaceChildren();
      tip = copy.evenTip;
    }

    // Longer badges ("Type 9", "4 or 9") get a smaller size so they stay inside the card.
    const badge = r('badge');
    badge.style.fontSize = (badge.textContent ?? '').length > 4 ? 'clamp(52px,6.4vw,76px)' : '';

    renderBars(res);
    setTypeStep(!!res.tieBreak?.decided);
    $$('.en-row', resultEl).forEach((row) => row.toggleAttribute('data-mine', res.kind !== 'even' && res.top.includes(Number(row.dataset.type) as TypeNumber)));
    r('tip').textContent = tip;

    const shareBase = { tag: 'Test / 02', url: 'https://knowpsyche.com/enneagram-test/', filename: 'knowpsyche-enneagram' };
    if (res.kind === 'clear') {
      const big = w1.length === 1 ? wingLabel(first, w1) : `Type ${first}`;
      const a = big.startsWith('8') ? 'an' : 'a';
      void share.update({ ...shareBase, label: `I'm ${a}`, big, badge: t1.name, tagline: t1.desire, text: `I'm ${a} ${big}, ${t1.name}` });
    } else if (res.kind === 'tie') {
      void share.update({ ...shareBase, label: `I may be ${an(first)}`, big: `${first} or ${second}`, badge: 'Two close types', tagline: "What's your type?", text: `I may be ${an(first)} ${first} or ${an(second)} ${second} on the Enneagram. What's your type?` });
    } else {
      void share.update({ ...shareBase, label: 'My Enneagram scores', big: 'Even', badge: 'No single type stood out', tagline: "What's your type?", text: "My Enneagram scores came out very even. What's your type?" });
    }

    saveOptIn.show({
      testId: 'enneagram',
      badge: r('badge').textContent ?? '',
      headline: r('headline').textContent ?? '',
      data: Object.fromEntries(res.ranked.map((x) => [String(x.type), x.sum])),
    });

    resultEl.hidden = false;
    r('headline').focus({ preventScroll: true });
    resultEl.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
  };

  // ---------- Input ----------
  answerButtons.forEach((b) => b.addEventListener('click', () => choose(Number(b.dataset.value))));
  tbButtons.forEach((b) => b.addEventListener('click', () => chooseTieBreak(b.dataset.choice as Choice)));
  $('.en-tb-skip').addEventListener('click', () => {
    if (!locked && pending) finish(pending);
  });
  back.addEventListener('click', goBack);
  $('.en-restart').addEventListener('click', () => {
    reset();
    answerButtons[0].focus();
  });
  r('toggle-bars').addEventListener('click', () => setAllBars(!r('bars').hasAttribute('data-all')));

  // Your own record to compare with in a few months, since we save nothing.
  bindCopy($('[data-copy-scores]', resultEl), $('[data-copy-status]', resultEl), () => {
    if (!shown) return '';
    const scores = shown.ranked.map((x) => `Type ${x.type} ${x.sum}/25`).join(' · ');
    return `${r('headline').textContent} (Enneagram, ${today()}, knowpsyche.com/enneagram-test/)\n${scores}`;
  });

  // Keys answer only while the card is on screen (or has focus), so reading the FAQ can't answer by accident.
  document.addEventListener('keydown', (e) => {
    if (done || e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
    if (!cardVisible() && !card.contains(document.activeElement)) return;
    const v = Number(e.key);
    if (!Number.isInteger(v)) return;
    if (phase === 'statements' && v >= 1 && v <= 5) {
      e.preventDefault();
      choose(v);
    } else if (phase === 'tiebreak' && v >= 1 && v <= 3) {
      e.preventDefault();
      chooseTieBreak((['a', 'b', 'same'] as const)[v - 1]);
    }
  });

  // A stray refresh mid-test would lose every answer.
  guardLeave(() => !done && answeredCount() > 0, ui.leaveWarning);

  const focusCard = () => {
    card.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'center' });
    (phase === 'tiebreak' ? tbButtons[0] : answerButtons[0]).focus({ preventScroll: true });
  };
  $('[data-test-start]').addEventListener('click', () => {
    if (done) reset();
    focusCard();
  });
  $$('[data-try-again]').forEach((b) =>
    b.addEventListener('click', () => {
      reset();
      focusCard();
    }),
  );

  render();
</script>
