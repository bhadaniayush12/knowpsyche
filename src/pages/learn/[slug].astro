---
/**
 * One Learn article. Layout from docs/design/Article.dc.html: kicker, H1 + deck, byline, art panel;
 * then "In this guide" (from the h2s), the markdown body with callouts, the related test, more articles,
 * FAQ, Sources and the "not medical advice" line.
 */
import { getEntries } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/result/Faq.astro';
import Sources from '../../components/result/Sources.astro';
import TestGlyph from '../../components/home/TestGlyph.astro';
import Logo from '../../components/Logo.astro';
import ArticleCard from '../../components/learn/ArticleCard.astro';
import Scene from '../../components/learn/scenes/Scene.astro';
import { dropTrailingLine, enhanceArticleHtml, readingTime, splitAtH2, tocFromHeadings } from '../../lib/learn/articles';
import { formatDate, getArticles, testFor, type Article } from '../../lib/learn/collection';
import { AUTHOR, articleFootnote, keepReadingLabel, tocLabel, tryTestLabel } from '../../data/learn';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, published: articles.map((a) => a.id) } }));
}

interface Props {
  article: Article;
  published: string[];
}
const { article, published } = Astro.props;
const { data } = article;
const path = `/learn/${article.id}/`;
const ogImage = `/og/learn-${article.id}.png`;
const site = Astro.site ?? new URL('https://knowpsyche.com');

// Body: the article's own "not medical advice" ending is dropped (it's printed under Sources), callouts
// and table wrappers added, then split at the h2s so an ad can sit between two sections.
const html = enhanceArticleHtml(dropTrailingLine(article.rendered?.html ?? '', articleFootnote));
const chunks = splitAtH2(html);
const toc = tocFromHeadings(article.rendered?.metadata?.headings ?? []);
// One ad, before the middle section, only when there are at least 3 sections.
const sectionStarts = chunks.flatMap((c, i) => (c.startsWith('<h2') ? [i] : []));
const adBefore = sectionStarts.length >= 3 ? sectionStarts[Math.ceil(sectionStarts.length / 2)] : -1;

// H1 with the `em` words in the blue serif.
const at = data.em ? data.title.indexOf(data.em) : -1;
const h1 = at >= 0 ? [data.title.slice(0, at), data.em!, data.title.slice(at + data.em!.length)] : [data.title, '', ''];

const test = testFor(article);
const testLabel = test && (/test$/i.test(test.name) ? test.name : `${test.name} test`);

// Related articles. A typo fails the build; a related article that's still a draft is skipped.
const relatedEntries = await getEntries(data.related);
relatedEntries.forEach((r, i) => {
  if (!r) throw new Error(`${article.id}: related article "${data.related[i].id}" doesn't exist`);
});
const related = relatedEntries.filter((r): r is Article => !!r && published.includes(r.id));

const faqs = data.faq?.map((f) => ({ q: f.question, a: f.answer }));
const minutes = readingTime(article.body ?? '');
const iso = (d: Date) => d.toISOString().slice(0, 10);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: iso(data.datePublished),
  dateModified: iso(data.dateModified),
  image: new URL(ogImage, site).href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(path, site).href },
  author: AUTHOR,
  publisher: AUTHOR,
};
---
<BaseLayout title={`${data.title} | KnowPsyche`} description={data.description} path={path} ogImage={ogImage} crumbs={[{ name: 'Learn', href: '/learn/' }, { name: data.title }]}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />

  <div class="read-progress" aria-hidden="true"><span></span></div>

  <section class="mx-auto flex max-w-[1200px] flex-wrap items-end gap-10 px-[clamp(16px,3vw,40px)] pt-[clamp(20px,4vw,48px)] pb-10">
    <div class="min-w-0 flex-[2_1_560px]">
      <div class="mb-[18px] text-[14px] text-muted"><a href="/learn/" class="hit-44 text-muted">Learn</a> / {data.category}</div>
      <h1 class="m-0 text-[clamp(46px,6.6vw,96px)] leading-[.94] font-semibold tracking-[-.05em]">{h1[0]}{h1[1] && <span class="serif text-blue">{h1[1]}</span>}{h1[2]}</h1>
      <p class="mt-[22px] mb-0 max-w-[620px] text-[21px] leading-[1.55] text-ink-soft">{data.deck ?? data.description}</p>
      <div class="mt-[26px] flex flex-wrap items-center gap-3 text-[14.5px] text-ink-soft">
        <span aria-hidden="true" class="inline-flex size-10 items-center justify-center rounded-full bg-lilac font-bold text-ink">{AUTHOR.name[0]}</span>
        <span><b class="text-ink">{AUTHOR.name}</b> · Updated <time datetime={iso(data.dateModified)}>{formatDate(data.dateModified)}</time> · {minutes}</span>
      </div>
    </div>
    <!-- Ink panel as designed for the dark test card and the pillar; the other glyphs are drawn for their
         tint and go faint on ink, so those panels use the test's tint. -->
    <div
      aria-hidden="true"
      class:list={['flex aspect-[360/220] min-w-0 max-w-[420px] flex-[1_1_300px] items-center justify-center overflow-hidden rounded-[26px] p-5', (!test || test.dark) && 'bg-ink']}
      style={test && !test.dark ? { background: test.tint } : undefined}
    >
      {data.scene ? (
        <Scene slug={data.scene} size={150} />
      ) : test ? (
        <div class="scale-[2.2]"><TestGlyph glyph={test.glyph} /></div>
      ) : (
        <div class="scale-[3]"><Logo wordmark={false} /></div>
      )}
    </div>
  </section>

  <div
    class="article-grid mx-auto flex max-w-[1200px] flex-wrap items-start gap-(--col-gap) border-t border-line px-[clamp(16px,3vw,40px)] pt-10 pb-20"
    style="--col-gap:clamp(28px,4vw,56px);--side-col:220px"
  >
    {toc.length > 0 && (
      <nav aria-label={tocLabel} class="toc flex min-w-0 max-w-[240px] flex-[1_1_200px] flex-col gap-1.5 text-[15px]">
        <span class="mb-1.5 text-[13px] font-semibold text-muted">{tocLabel}</span>
        {toc.map((t, i) => (
          <a href={`#${t.slug}`} data-active={i === 0 ? '' : undefined} class="flex min-h-11 items-center border-l-2 border-line pl-3 no-underline data-active:border-blue">{t.num} · {t.text}</a>
        ))}
      </nav>
    )}

    <article class="min-w-0 max-w-[700px] flex-[999_1_560px]">
      <div class="prose" data-article-body>
        {chunks.map((c, i) => (
          <>
            {i === adBefore && <AdSlot class="my-8" />}
            <Fragment set:html={c} />
          </>
        ))}
      </div>

      {test && (
        <div class="my-9 flex flex-wrap items-center justify-between gap-4 rounded-22 bg-ink p-6 text-paper">
          <div>
            <div class="mb-1 text-[13px] font-semibold text-yellow">{tryTestLabel}</div>
            <div class="text-[21px] font-semibold tracking-[-.02em]">{test.desc}</div>
          </div>
          <a href={test.href} class="inline-flex min-h-12 items-center rounded-12 bg-yellow px-[18px] py-[13px] font-semibold text-ink no-underline hover:text-ink">{testLabel} →</a>
        </div>
      )}

      {related.length > 0 && (
        <section aria-labelledby="keep-reading" class="mt-12">
          <h2 id="keep-reading" class="m-0 mb-4 text-[clamp(28px,3.4vw,34px)] font-semibold tracking-[-.04em]">{keepReadingLabel}</h2>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-4">
            {related.map((r) => <ArticleCard article={r} />)}
          </div>
        </section>
      )}

      {faqs && <div class="mt-12"><Faq faqs={faqs} /></div>}

      <div class="mt-10 border-t border-line pt-5">
        <Sources sources={data.sources} />
        <p class="mt-3.5 mb-0 text-[14px] text-muted">{articleFootnote}</p>
      </div>
    </article>

    <!-- Wide screens: the side notes' column (they float into it from the text). -->
    <div aria-hidden="true" class="hidden min-[1200px]:block"></div>
  </div>
</BaseLayout>

<style>
  /* Wide screens: three fixed columns, so the side notes always have their column. */
  @media (min-width: 1200px) {
    .article-grid {
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr) var(--side-col);
    }
    .article-grid:not(:has(.toc)) { grid-template-columns: minmax(0, 1fr) var(--side-col); }
  }
</style>

<script>
  // "In this guide": mark the section being read. Without JS the first item stays marked.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((h): h is HTMLElement => !!h);
  if (links.length && heads.length && 'IntersectionObserver' in window) {
    const setActive = (id: string) => links.forEach((a) => a.toggleAttribute('data-active', a.hash === `#${id}`));
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    heads.forEach((h) => io.observe(h));
  }
</script>
