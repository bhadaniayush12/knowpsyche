---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Copy word for word from docs/design/Method.dc.html. Placeholders filled as Dev decided:
// "every six months", last reviewed 17 October 2026.
// Icons: Lucide (https://lucide.dev), ISC licence, paths copied inline.
const icons = {
  flask: '<path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2"/><path d="M6.453 15h11.094"/><path d="M8.5 2h7"/>',
  calculator: '<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>',
  gauge: '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  listChecks: '<path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>',
  ban: '<circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/>',
  // Lucide "pencil" and "refresh-cw", for the sections added after Test by test.
  pencil: '<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/>',
  refresh: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  bookOpen: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
};
const title = 'Our method | KnowPsyche';
const description =
  "How KnowPsyche builds its tests: where the questions come from, how scoring works, what each result can and can't tell you, and what we never do.";

const cards = [
  {
    label: '01 · Where questions come from',
    icon: icons.flask,
    border: 'border-t-blue',
    color: 'text-blue',
    text: 'Cognitive tasks are rebuilt from classic experiments described in research. Personality statements are written by us. We never copy commercial tests or use their trademarked names.',
  },
  {
    label: '02 · How scoring works',
    icon: icons.calculator,
    border: 'border-t-gold',
    color: 'text-gold-ink',
    text: 'Scoring runs in your browser, and each test page shows its formula. Reaction time, for example, is the average of five timed tries. Nothing you answer is sent to us.',
  },
  {
    label: '03 · What a result means',
    icon: icons.gauge,
    border: 'border-t-coral',
    color: 'text-coral-ink',
    text: 'A result describes how you did on one task, on one day, on one device. We show ranges, not verdicts, and never claim to measure clinical conditions or certify IQ.',
  },
];

const columns = ['Test', 'What it measures', 'Based on', 'Keep in mind'];
// Each column's flex basis on wide screens, from the design.
const flex = ['lg:flex-[1_1_180px]', 'lg:flex-[2_1_240px]', 'lg:flex-[2_1_220px]', 'lg:flex-[2_1_240px]'];
const rows = [
  ['Reaction time', 'Time from a change (light or sound) to your press', 'Simple reaction-time tasks', "Screens and mice add delay you can't see"],
  ['Enneagram', 'Which of nine motivation patterns fits you best', 'Original statements based on the Enneagram model', 'The model has limited research support, so use it for reflection'],
  ['Photographic memory', 'How much of a visual layout you can rebuild', 'Visual short-term memory tasks', '“Photographic memory” is a popular name; true eidetic memory is rare and debated'],
  ['Number memory', 'The longest number you can hold in mind', 'Digit-span tasks', 'Practice and chunking strategies raise scores'],
  ['Attention span', 'Responding to targets while holding back on the rest', 'Go / No-Go tasks', 'A few minutes of one session, not your attention in daily life'],
  ['Stroop effect', 'The slowdown when a word and its ink colour clash', "J. R. Stroop's 1935 experiments", 'Reading speed and colour vision both affect it'],
  ['Emotional intelligence', 'How you see your own emotional awareness and responses', 'Original items informed by emotional-intelligence models', 'Self-report shows how you see yourself, not how others see you'],
];

// Drafted (M1): one line per test, checked against src/lib/tests/*.ts.
const maths = [
  ['Reaction time', 'The average of five timed tries, in milliseconds. A press under 100 ms counts as a guess, and that try is repeated.'],
  ['Enneagram', 'You rate 45 statements from 1 to 5, five for each of the nine types, so each type scores 5 to 25. If your top types are very close, a short tie-break round follows.'],
  ['Photographic memory', 'Level 1 lights 3 tiles for 1.2 seconds, and each level adds one. A wrong tile costs one of your three lives. Your score is the highest level you fully completed.'],
  ['Number memory', 'The number starts at 3 digits and grows by one each time you type it back correctly. A wrong answer costs one of your two lives. Your score is the longest number you got right.'],
  ['Attention span', 'Of 80 circles, 60 are green and 20 are red. Your score out of 100 is the average of two percentages: greens you caught in time and reds you held back on. Your speed is shown but does not change the score.'],
  ['Stroop test', 'Of 40 words, half match their ink colour and half clash. Your Stroop effect is your average time on clashing words minus your average time on matching words, counting correct answers only.'],
  ['Emotional intelligence', 'You rate 28 statements from 1 to 5, seven in each of four areas, and some are scored in reverse. Each area becomes a score from 0 to 100, and your overall score is the average of the four.'],
];

// Drafted (M1): the three short sections after "The maths". Body text b and c given by Dev; c and d reworded
// to match the site (test pages show no "last reviewed" date; articles show "Updated").
const notes = [
  {
    label: 'Why bands, not rankings',
    icon: icons.gauge,
    border: 'border-t-coral',
    color: 'text-coral-ink',
    lead: 'Your own number, ',
    accent: 'not a league table.',
    accentColor: 'text-coral-ink',
    text: 'A band is a label for your own number: what that range usually looks like, and what could change it. We never rank you against other people, because a ranking needs a fair, representative sample we don’t have, and results from different devices can’t be compared fairly.',
  },
  {
    label: 'When we get something wrong',
    icon: icons.pencil,
    border: 'border-t-teal',
    color: 'text-teal-ink',
    lead: 'Tell us, ',
    accent: 'and we fix it.',
    accentColor: 'text-teal-ink',
    text: 'If you find a mistake, tell us on the {contact page}. We check it and fix it, and an article shows its new date.',
  },
  {
    label: 'How often we review',
    icon: icons.refresh,
    border: 'border-t-gold',
    color: 'text-gold-ink',
    lead: 'Every six months, ',
    accent: 'or sooner.',
    accentColor: 'text-gold-ink',
    text: 'Each test page lists its sources, and every article shows the date we last updated it. We re-read every test and article about every six months, and sooner if new research changes something.',
  },
];
---
<BaseLayout title={title} description={description} path="/method/" crumbs={[{ name: 'Our method' }]}>
  <div class="mx-auto flex max-w-[1200px] flex-col gap-[clamp(56px,7vw,96px)] px-[clamp(16px,3vw,40px)] pt-[clamp(24px,4vw,56px)] pb-20">
    <section>
      <div class="mono mb-[18px] text-[11px] text-muted">Our method · Evidence before certainty</div>
      <h1 class="m-0 max-w-[1000px] text-[clamp(46px,6.4vw,100px)] leading-[.92] font-semibold tracking-[-.055em]">How our tests work,<br /><span class="serif text-red">and where they stop.</span></h1>
      <p class="m-0 mt-6 max-w-[680px] text-[19px] leading-[1.6] text-ink-soft">Short version: honest tasks, transparent scoring, every limit written down. Here is the long version.</p>
    </section>

    <section class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-5">
      {cards.map((c) => (
        <div class:list={['flex flex-col gap-3 border border-t-[5px] border-ink bg-card p-[26px]', c.border]}>
          <div class="flex items-center justify-between gap-3">
            <div class:list={['mono text-[11px]', c.color]}>{c.label}</div>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={c.icon} />
          </div>
          <p class="m-0 text-base leading-[1.65]">{c.text}</p>
        </div>
      ))}
    </section>

    <section>
      <div class="mb-3 flex items-center gap-3">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.listChecks} />
        <span class="mono text-[11px] text-muted">Test by test</span>
      </div>
      <h2 class="m-0 mb-[26px] text-[clamp(36px,4.4vw,60px)] leading-[.95] font-semibold tracking-[-.05em]">What each test does, <span class="serif text-violet">and doesn't.</span></h2>
      {/* Flex rows (as designed) with ARIA table roles: Safari drops native table semantics on display:flex.
           Below lg the rows stack, so the heading row is visually hidden and each cell shows its own label. */}
      <div role="table" aria-label="What each test does, and doesn't" class="border-t border-ink">
        <div role="rowgroup">
          <div role="row" class="mono flex gap-4 border-b border-ink py-3 text-[10.5px] text-muted max-lg:sr-only">
            {columns.map((c, i) => <span role="columnheader" class={flex[i]}>{c}</span>)}
          </div>
        </div>
        <div role="rowgroup">
          {rows.map((row, i) => (
            <div role="row" class:list={['flex flex-col gap-3 border-b py-[18px] text-[15.5px] leading-[1.55] lg:flex-row lg:gap-4', i === rows.length - 1 ? 'border-ink' : 'border-line-inner']}>
              {row.map((text, j) => (
                <div role={j === 0 ? 'rowheader' : 'cell'} class:list={[flex[j], j === 0 && 'font-bold', j === 3 && 'text-ink-soft']}>
                  {j > 0 && <span aria-hidden="true" class="mono mb-1 block text-[10.5px] font-normal text-muted lg:hidden">{columns[j]}</span>}
                  {text}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Drafted (M1): how each score is worked out. */}
    <section aria-labelledby="maths-title">
      <div class="mb-3 flex items-center gap-3">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.calculator} />
        <span class="mono text-[11px] text-muted">How each score is worked out</span>
      </div>
      <h2 id="maths-title" class="m-0 mb-[26px] text-[clamp(36px,4.4vw,60px)] leading-[.95] font-semibold tracking-[-.05em]">The maths, <span class="serif text-blue">in plain words.</span></h2>
      <dl class="m-0 border-t border-ink">
        {maths.map(([name, line], i) => (
          <div class:list={['flex flex-col gap-1.5 border-b py-[18px] text-[15.5px] leading-[1.55] lg:flex-row lg:gap-4', i === maths.length - 1 ? 'border-ink' : 'border-line-inner']}>
            <dt class="font-bold lg:flex-[1_1_180px]">{name}</dt>
            <dd class="m-0 lg:flex-[6_1_720px]">{line}</dd>
          </div>
        ))}
      </dl>
    </section>

    {/* Drafted (M1): bands, corrections, reviews. */}
    {notes.map((n, i) => (
      <section aria-labelledby={`note-${i}`}>
        <div class="mb-3 flex items-center gap-3">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={n.icon} />
          <span class="mono text-[11px] text-muted">{n.label}</span>
        </div>
        <h2 id={`note-${i}`} class="m-0 mb-[22px] text-[clamp(36px,4.4vw,60px)] leading-[.95] font-semibold tracking-[-.05em]">{n.lead}<span class:list={['serif', n.accentColor]}>{n.accent}</span></h2>
        <div class:list={['max-w-[820px] border border-t-[5px] border-ink bg-card p-[26px]', n.border]}>
          <p class="m-0 text-[17px] leading-[1.65]">
            {n.text.split(/\{|\}/).map((part, j) => (j % 2 ? <a href="/contact/" class="font-semibold underline underline-offset-[3px]">{part}</a> : part))}
          </p>
        </div>
      </section>
    ))}

    <section class="flex flex-wrap gap-6">
      <div class="min-w-0 flex-[1_1_360px] border border-ink bg-lilac p-[clamp(22px,3vw,36px)] shadow-[8px_8px_0_var(--color-ink)]">
        <div class="mb-3 flex items-center gap-3">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.ban} />
          <span class="mono text-[11px] text-muted">What we never do</span>
        </div>
        <ul class="m-0 pl-5 text-[17px] leading-[1.85]">
          <li>Test for depression, anxiety, ADHD or any clinical condition</li>
          <li>Sell “certified” IQ scores</li>
          <li>Lock results behind an email or payment</li>
          <li>Store your answers on our servers</li>
        </ul>
      </div>
      <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-3.5 border border-ink bg-card p-[clamp(22px,3vw,36px)]">
        <div class="flex items-center gap-3">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.bookOpen} />
          <span class="mono text-[11px] text-teal-ink">Sources &amp; corrections</span>
        </div>
        <p class="m-0 text-[17px] leading-[1.65]">Each test page lists the research it draws on. We review our pages every six months and whenever someone reports a problem.</p>
        <a href="/contact/" class="inline-flex min-h-11 items-center self-start font-semibold underline">Report an error →</a>
        <div class="mono border-t border-dashed border-line-inner pt-3 text-[10.5px] text-muted">Last reviewed: 17 October 2026</div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .icon {
    flex: none;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
