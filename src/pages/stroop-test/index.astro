---
import TestPage from '../../layouts/TestPage.astro';
import ResultHeadline from '../../components/result/ResultHeadline.astro';
import ScoreVisual from '../../components/result/ScoreVisual.astro';
import BandScale from '../../components/result/BandScale.astro';
import WhatItMeans from '../../components/result/WhatItMeans.astro';
import TryThis from '../../components/result/TryThis.astro';
import BandsNote from '../../components/result/BandsNote.astro';
import ShareCard from '../../components/result/ShareCard.astro';
import TryAgain from '../../components/result/TryAgain.astro';
import NextTest from '../../components/result/NextTest.astro';
import CopyScores from '../../components/result/CopyScores.astro';
import SaveResult from '../../components/result/SaveResult.astro';
import ProgressTrail from '../../components/result/ProgressTrail.astro';
import FeedbackToggle from '../../components/ui/FeedbackToggle.astro';
import { faqs, page, result, resultUi, sources, stroopBands, ui, happening } from '../../data/tests/stroop';
import { TOTAL_TRIALS } from '../../lib/tests/stroop';

const segClass = ['flex-[80] bg-paper', 'flex-[80] bg-lilac', 'flex-[90] bg-lilac-bright', 'flex-[70] bg-blue'];
const ranges = ['<80 ms', '80–160', '161–250', '>250 ms'];
---
<TestPage
  title={page.title}
  description={page.description}
  path="/stroop-test/"
  crumb={page.crumb}
  eyebrow={page.eyebrow}
  h1={page.h1}
  intro={page.intro}
  introTouch={page.introTouch}
  metaLine={page.metaLine}
  faqs={faqs}
  sources={sources}
  happening={happening}
  preloadBold
>
  <div
    slot="stage"
    tabindex="-1"
    class="st-card rounded-[26px] outline-none border border-line-card bg-white p-[clamp(16px,4vw,40px)] shadow-[0_26px_54px_rgba(36,34,56,.12)] select-none"
  >
    <!-- Colour-vision note and skip option -->
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-line pb-3 text-xs text-muted">
      <p class="m-0 max-w-[560px] leading-relaxed">
        {ui.colourVisionNote}
      </p>
      <a href="/attention-span-test/" class="mono inline-flex min-h-11 items-center text-[11px] font-semibold text-blue hover:underline">
        {ui.skipNote}
      </a>
    </div>

    <!-- Header: counter + restart -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <!-- Two lines reserved: on phones the counter and note sit on their own lines, top-aligned, so no state moves them (no layout shift). -->
      <div class="mono flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] max-sm:min-h-[calc(2lh+0.25rem)] max-sm:flex-col max-sm:items-start max-sm:justify-start">
        <span class="st-counter">{ui.practiceLabel}</span>
        <span class="st-note text-muted">{ui.practiceNote}</span>
      </div>
      <div class="flex gap-2">
        <FeedbackToggle />
        <button
          type="button"
          class="st-restart mono inline-flex min-h-11 shrink-0 items-center whitespace-nowrap border border-ink bg-transparent px-4 text-xs text-ink hover:border-blue hover:text-blue"
        >{ui.restart}</button>
      </div>
    </div>

    <!-- Word display arena -->
    <div
      class="st-arena relative mt-4 flex min-h-[290px] sm:min-h-[260px] w-full flex-col items-center justify-center rounded-[20px] border border-line-inner/40 bg-card p-6 text-center"
    >
      <!-- Idle view -->
      <div data-st-view="idle" class="flex flex-col items-center gap-3">
        <p class="serif m-0 text-[clamp(28px,4vw,38px)] text-ink">{ui.practiceLabel}</p>
        <p class="pointer-swap m-0 max-w-[460px] text-[16.5px] leading-[1.55] text-ink-soft">
          <span class="on-mouse">{page.intro}</span><span class="on-touch">{page.introTouch}</span>
        </p>
        <button
          type="button"
          class="st-start-practice mono mt-2 inline-flex min-h-12 items-center justify-center rounded-12 border-0 bg-ink px-6 py-3 text-xs font-semibold text-paper transition-colors duration-200 hover:bg-blue"
        >
          <span class="pointer-swap"><span class="on-mouse">{ui.ready}</span><span class="on-touch">{ui.readyTouch}</span></span>
        </button>
      </div>

      <!-- Active Word view -->
      <div data-st-view="active" class="flex flex-col items-center justify-center gap-2" hidden>
        <div
          class="st-word text-[clamp(54px,11vw,96px)] font-bold tracking-tight leading-none select-none transition-transform duration-75"
        ></div>
        <p class="st-feedback mono absolute inset-x-4 bottom-4 m-0 text-center text-[15px] font-medium" aria-live="polite"></p>
      </div>

      <!-- Practice complete view -->
      <div data-st-view="practice-done" class="flex flex-col items-center gap-3" hidden>
        <p class="serif m-0 text-[clamp(28px,4vw,38px)] text-ink">{ui.practiceDoneTitle}</p>
        <p class="m-0 max-w-[460px] text-[16.5px] leading-[1.55] text-ink-soft">{ui.practiceDoneText}</p>
        <button
          type="button"
          class="st-start-main mono mt-2 inline-flex min-h-12 items-center justify-center rounded-12 border-0 bg-ink px-6 py-3 text-xs font-semibold text-paper transition-colors duration-200 hover:bg-blue"
        >
          {ui.startMain}
        </button>
      </div>

      <!-- Paused view (when tab is hidden or blurred) -->
      <div data-st-view="paused" class="flex flex-col items-center gap-3" hidden>
        <p class="serif m-0 text-[clamp(28px,4vw,38px)] text-coral-ink">{ui.pausedTitle}</p>
        <p class="m-0 max-w-[460px] text-[16.5px] leading-[1.55] text-ink-soft">{ui.pausedMessage}</p>
        <button
          type="button"
          class="st-paused-restart mono mt-2 inline-flex min-h-12 items-center justify-center rounded-12 border-0 bg-ink px-6 py-3 text-xs font-semibold text-paper transition-colors duration-200 hover:bg-blue"
        >
          {ui.restart}
        </button>
      </div>
    </div>

    <!-- 4 Answer buttons: 44px min height, thumb-friendly at 360px -->
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4" role="group" aria-label={ui.choicesLabel}>
      <button
        type="button"
        data-color="red"
        class="st-btn inline-flex min-h-[52px] items-center justify-center gap-2 rounded-14 border border-ink bg-white px-4 py-3 text-base font-semibold text-ink transition-colors duration-150 hover:bg-line-row focus:outline-none focus-visible:outline-2 focus-visible:outline-blue"
      >
        <span class="size-3.5 rounded-full border border-ink/20" style="background-color: var(--color-red)" aria-hidden="true"></span>
        <span>Red</span>
        <span class="mono ml-1 text-xs text-muted" aria-hidden="true">[R]</span>
      </button>

      <button
        type="button"
        data-color="blue"
        class="st-btn inline-flex min-h-[52px] items-center justify-center gap-2 rounded-14 border border-ink bg-white px-4 py-3 text-base font-semibold text-ink transition-colors duration-150 hover:bg-line-row focus:outline-none focus-visible:outline-2 focus-visible:outline-blue"
      >
        <span class="size-3.5 rounded-full border border-ink/20" style="background-color: var(--color-blue)" aria-hidden="true"></span>
        <span>Blue</span>
        <span class="mono ml-1 text-xs text-muted" aria-hidden="true">[B]</span>
      </button>

      <button
        type="button"
        data-color="green"
        class="st-btn inline-flex min-h-[52px] items-center justify-center gap-2 rounded-14 border border-ink bg-white px-4 py-3 text-base font-semibold text-ink transition-colors duration-150 hover:bg-line-row focus:outline-none focus-visible:outline-2 focus-visible:outline-blue"
      >
        <span class="size-3.5 rounded-full border border-ink/20" style="background-color: var(--color-teal-deep)" aria-hidden="true"></span>
        <span>Green</span>
        <span class="mono ml-1 text-xs text-muted" aria-hidden="true">[G]</span>
      </button>

      <button
        type="button"
        data-color="yellow"
        class="st-btn inline-flex min-h-[52px] items-center justify-center gap-2 rounded-14 border border-ink bg-white px-4 py-3 text-base font-semibold text-ink transition-colors duration-150 hover:bg-line-row focus:outline-none focus-visible:outline-2 focus-visible:outline-blue"
      >
        <span class="size-3.5 rounded-full border border-ink/20" style="background-color: var(--color-yellow)" aria-hidden="true"></span>
        <span>Yellow</span>
        <span class="mono ml-1 text-xs text-muted" aria-hidden="true">[Y]</span>
      </button>
    </div>
  </div>

  <Fragment slot="result">
    <ResultHeadline />

    <ScoreVisual>
      <div class="flex flex-wrap items-stretch gap-[clamp(24px,4vw,40px)]">
        <div class="flex min-w-0 flex-[999_1_520px] flex-col gap-[22px]">
          <div class="flex flex-wrap items-end gap-[18px]">
            <div class="text-[clamp(88px,14vw,200px)] leading-[.8] font-semibold tracking-[-.07em]">
              <span data-r="effect">0</span><span class="ml-2 text-[.32em] tracking-[-.03em]" data-r="effect-unit">ms</span>
            </div>
            {/* Drafted: matches neutral band badge */}
            <div class="serif pb-2.5 text-[34px] text-blue" data-r="badge">Mild pull</div>
          </div>
          <BandScale segments={stroopBands.map((b, i) => ({ class: segClass[i], range: ranges[i], label: b.badge }))} />
        </div>

        <div class="flex min-w-0 flex-[1_1_320px] flex-col justify-between gap-4 border border-ink bg-card p-[22px]">
          <div class="mono text-[11px] text-muted">{resultUi.cardTitle}</div>

          <!-- Two comparative bars for matching vs clashing -->
          <div class="flex flex-col gap-3">
            <div>
              <div class="mono flex justify-between text-[11px]">
                <span>{resultUi.matching}</span>
                <span class="font-semibold text-teal-ink" data-r="matching-avg">0 ms</span>
              </div>
              <div class="mt-1.5 h-3 w-full overflow-hidden rounded-full bg-line" aria-hidden="true">
                <div class="h-full rounded-full bg-teal-dark transition-[width] duration-300" data-r="matching-bar" style="width:50%"></div>
              </div>
            </div>

            <div>
              <div class="mono flex justify-between text-[11px]">
                <span>{resultUi.clashing}</span>
                <span class="font-semibold text-coral-ink" data-r="clashing-avg">0 ms</span>
              </div>
              <div class="mt-1.5 h-3 w-full overflow-hidden rounded-full bg-line" aria-hidden="true">
                <div class="h-full rounded-full bg-coral transition-[width] duration-300" data-r="clashing-bar" style="width:75%"></div>
              </div>
            </div>

            <div class="mt-1 flex items-center justify-between border-t border-line-inner pt-2">
              <span class="mono text-[11px] text-muted">{resultUi.accuracy}</span>
              <span class="text-[18px] font-semibold text-ink" data-r="accuracy">100%</span>
            </div>
          </div>

          <CopyScores label={ui.copyScore} class="mt-1 border-t border-line-inner pt-3" />
        </div>
      </div>
    </ScoreVisual>

    <WhatItMeans change={result.change} />

    <TryThis />

    <BandsNote />

    <SaveResult testId="stroop" />

    <ShareCard>
      <TryAgain />
    </ShareCard>

    <ProgressTrail variant="card" current="stroop" />

    <NextTest from="/stroop-test/" line={result.nextLine} learn={result.learn} />
  </Fragment>
</TestPage>

<style is:global>
  .st-word[data-ink='red'] { color: var(--color-red); }
  .st-word[data-ink='blue'] { color: var(--color-blue); }
  .st-word[data-ink='green'] { color: var(--color-teal-deep); }
  /* Yellow on the card is only 1.5:1, so the word gets an ink outline (as in global.css) to stay readable. */
  .st-word[data-ink='yellow'] { color: var(--color-yellow); -webkit-text-stroke: 1.5px var(--color-ink); }

  .st-word[data-blank] {
    opacity: 0;
  }
</style>

<script>
  import { result as copy, resultUi, ui } from '../../data/tests/stroop';
  import {
    calculateStroopScores,
    generateStroopTrials,
    getBand,
    getPracticeTrials,
    meaningLine,
    scalePercent,
    shareText,
    effectLabel,
    GAP_MS,
    TOTAL_TRIALS,
    WORD_TIMEOUT_MS,
    type StroopColor,
    type StroopResponse,
    type StroopScores,
    type StroopTrial,
  } from '../../lib/tests/stroop';
  import { createShareCard } from '../../lib/share-card';
  import { bindFeedbackToggle, cue } from '../../lib/feedback';
  import { initSaveOptIn } from '../../lib/saved-results';
  import { $, $$, bindCopy, guardLeave, onScreen, prefersReducedMotion, runFor, today } from '../../lib/test-ui';

  type Mode = 'idle' | 'practice' | 'practice-done' | 'main' | 'paused' | 'done';

  /** Practice only: how long the feedback stays up (with the word) before the 0.4 s gap. */
  const PRACTICE_FEEDBACK_MS = 700;
  const PRACTICE_MISSED_MS = 800;

  const card = $('.st-card');
  const arena = $('.st-arena');
  const counter = $('.st-counter');
  const note = $('.st-note');
  const restartBtn = $('.st-restart');
  const startPracticeBtn = $('.st-start-practice');
  const startMainBtn = $('.st-start-main');
  const pausedRestartBtn = $('.st-paused-restart');
  const wordEl = $('.st-word');
  const feedbackEl = $('.st-feedback');
  const choiceBtns = $$<HTMLButtonElement>('.st-btn');
  const resultEl = $('[data-result]');
  const saveOptIn = initSaveOptIn($('[data-save-optin]', resultEl));
  const isCardOnScreen = onScreen(card);
  const scrollBehavior = (): ScrollBehavior => (prefersReducedMotion() ? 'auto' : 'smooth');

  const views = {
    idle: $('[data-st-view="idle"]', arena),
    active: $('[data-st-view="active"]', arena),
    practiceDone: $('[data-st-view="practice-done"]', arena),
    paused: $('[data-st-view="paused"]', arena),
  };

  const share = createShareCard($('[data-share]'));

  // Bound once; the text is filled in when a result is shown.
  let copyText = '';
  bindCopy($('[data-copy-scores]', resultEl), $('[data-copy-status]', resultEl), () => copyText);

  let mode: Mode = 'idle';
  let trialList: StroopTrial[] = [];
  let trialIndex = 0;
  let responses: StroopResponse[] = [];
  // Onset of the word on screen: the timestamp of the frame that paints it.
  let stimulusPaintTime = 0;
  let answeredThisTrial = false;
  let cancel: () => void = () => {};

  function setView(target: 'idle' | 'active' | 'practiceDone' | 'paused') {
    views.idle.hidden = target !== 'idle';
    views.active.hidden = target !== 'active';
    views.practiceDone.hidden = target !== 'practiceDone';
    views.paused.hidden = target !== 'paused';
  }

  function clearTimers() {
    cancel();
    cancel = () => {};
  }

  function blankWord() {
    wordEl.textContent = '';
    wordEl.removeAttribute('data-ink');
    wordEl.setAttribute('data-blank', '');
  }

  // A hidden tab or lost focus breaks the timing, so the run stops and is never scored.
  function pauseBrokenRun() {
    if (mode !== 'main' && mode !== 'practice') return;
    clearTimers();
    mode = 'paused';
    blankWord();
    feedbackEl.textContent = '';
    // A broken scored run has no result, so its reserved space goes too (no empty gap below).
    resultEl.hidden = true;
    setView('paused');
    pausedRestartBtn.focus({ preventScroll: true });
  }

  window.addEventListener('blur', pauseBrokenRun);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) pauseBrokenRun();
  });

  guardLeave(() => mode === 'main' || mode === 'practice', ui.leaveWarning);

  function startPractice() {
    clearTimers();
    mode = 'practice';
    trialList = getPracticeTrials();
    trialIndex = 0;
    responses = [];
    counter.textContent = ui.practiceLabel;
    note.textContent = ui.practiceNote;
    feedbackEl.textContent = '';
    setView('active');
    runNextTrial();
  }

  function startMainRun() {
    clearTimers();
    mode = 'main';
    trialList = generateStroopTrials();
    trialIndex = 0;
    // Practice answers are thrown away here: only the 40 main words are scored.
    // The result's space is taken now, invisibly, while this click or key explains why the page grew.
    // The run can end with no input (last stimulus not answered), and showing it then would make
    // everything below jump.
    resultEl.classList.add('invisible');
    resultEl.hidden = false;
    responses = [];
    counter.textContent = ui.wordCount(1, TOTAL_TRIALS);
    note.textContent = ui.mainNote;
    setView('active');
    feedbackEl.textContent = '';
    runNextTrial();
  }

  /** Practice only: the scored run gives no feedback, so it plays no sound either. */
  function setFeedback(text: string, good: boolean) {
    cue(good ? 'right' : 'wrong');
    feedbackEl.textContent = text;
    feedbackEl.className = `st-feedback mono absolute inset-x-4 bottom-4 m-0 text-center text-[15px] font-medium ${good ? 'text-teal-ink' : 'text-coral-ink'}`;
  }

  // 0.4 s blank gap → word until answered (max 3 s, then missed) → next gap. Every step is checked
  // per frame against performance.now() (runFor), so nothing drifts the way chained setTimeouts do.
  /** `from` = the frame the previous word ended in, so the gap is timed from what was painted. */
  function runNextTrial(from?: number) {
    clearTimers();
    if (trialIndex >= trialList.length) {
      if (mode === 'practice') {
        mode = 'practice-done';
        counter.textContent = ui.practiceDoneTitle;
        note.textContent = ui.practiceDoneNote;
        setView('practiceDone');
      } else if (mode === 'main') {
        finishMainTest();
      }
      return;
    }

    answeredThisTrial = false;
    const currentTrial = trialList[trialIndex];
    if (mode === 'main') {
      counter.textContent = ui.wordCount(trialIndex + 1, TOTAL_TRIALS);
    } else {
      counter.textContent = ui.practiceCount(trialIndex + 1, trialList.length);
    }
    feedbackEl.textContent = '';
    blankWord();

    cancel = runFor(GAP_MS, (shownAt) => {
      // Painted at the end of this frame, so this frame's timestamp is the onset.
      stimulusPaintTime = shownAt;
      wordEl.textContent = currentTrial.word.toUpperCase();
      wordEl.setAttribute('data-ink', currentTrial.ink);
      wordEl.removeAttribute('data-blank');

      // No answer within 3 s counts as missed.
      cancel = runFor(WORD_TIMEOUT_MS, (missedAt) => {
        if (answeredThisTrial) return;
        answeredThisTrial = true;
        responses.push({ trial: currentTrial, correct: false });
        if (mode === 'practice') setFeedback(ui.practiceMissed, false);
        next(missedAt, PRACTICE_MISSED_MS);
      }, undefined, shownAt);
    }, undefined, from);
  }

  /** Main run: the word goes and the 0.4 s gap starts now. Practice: feedback stays up first. */
  function next(at: number, practiceHoldMs: number) {
    trialIndex++;
    if (mode === 'practice') {
      cancel = runFor(practiceHoldMs, (t) => runNextTrial(t), undefined, at);
    } else {
      runNextTrial(at);
    }
  }

  /** `t` = the input event's high-resolution timestamp. */
  function handleAnswer(color: StroopColor, t: number) {
    if (mode !== 'practice' && mode !== 'main') return;
    if (answeredThisTrial) return;
    if (!wordEl.hasAttribute('data-ink')) return;

    answeredThisTrial = true;
    clearTimers();

    const rt = Math.max(1, Math.round((t >= stimulusPaintTime ? t : performance.now()) - stimulusPaintTime));
    const currentTrial = trialList[trialIndex];
    const isCorrect = color === currentTrial.ink;

    responses.push({
      trial: currentTrial,
      picked: color,
      correct: isCorrect,
      reactionTimeMs: rt,
    });

    if (mode === 'practice') {
      if (isCorrect) setFeedback(ui.practiceCorrect, true);
      else setFeedback(ui.practiceWrong, false);
    }

    // The gap is timed from the input event, which is when the answer was given.
    next(Math.min(t, performance.now()), PRACTICE_FEEDBACK_MS);
  }

  function finishMainTest() {
    clearTimers();
    mode = 'done';
    const scores = calculateStroopScores(responses);
    renderResults(scores);
  }

  function renderResults(scores: StroopScores) {
    const band = getBand(scores.stroopEffectMs);
    resultEl.hidden = false;
    resultEl.classList.remove('invisible');

    // Headline
    $('[data-r=eyebrow]', resultEl).textContent = resultUi.eyebrow;
    const headline = $('[data-r=headline]', resultEl);
    // No correct answer on one word type: no effect number anywhere.
    const measured = scores.measured;
    // 0 ms or less shows "No slowdown", never a negative number.
    const slowed = scores.stroopEffectMs > 0;
    headline.textContent = measured ? `${band.badge} · ${effectLabel(scores.stroopEffectMs)}` : copy.notMeasured;
    headline.focus({ preventScroll: true });

    // Scores
    const effectEl = $('[data-r=effect]', resultEl);
    effectEl.textContent = !measured ? 'None' : slowed ? String(scores.stroopEffectMs) : copy.noSlowdownLabel;
    // The words need a smaller size than a number to stay inside the card.
    effectEl.parentElement!.style.fontSize = measured && !slowed ? 'clamp(44px,7vw,96px)' : '';
    $('[data-r=badge]', resultEl).textContent = measured ? band.badge : '';
    $('[data-r=effect-unit]', resultEl).hidden = !measured || !slowed;

    // Marker
    const marker = $('[data-r=marker]', resultEl);
    const markerLabel = $('[data-r=marker-label]', resultEl);
    const pct = scalePercent(scores.stroopEffectMs);
    marker.style.left = `${pct}%`;
    markerLabel.style.left = `${pct}%`;
    markerLabel.textContent = `You · ${effectLabel(scores.stroopEffectMs)}`;
    marker.hidden = !measured;
    markerLabel.hidden = !measured;

    // Comparative bars
    $('[data-r=matching-avg]', resultEl).textContent = scores.matchingCorrectCount > 0 ? `${scores.matchingAvgMs} ms` : 'None';
    $('[data-r=clashing-avg]', resultEl).textContent = scores.clashingCorrectCount > 0 ? `${scores.clashingAvgMs} ms` : 'None';
    $('[data-r=accuracy]', resultEl).textContent = `${scores.accuracy}%`;

    const maxMs = Math.max(scores.matchingAvgMs, scores.clashingAvgMs, 1000);
    const matchingBar = $('[data-r=matching-bar]', resultEl);
    const clashingBar = $('[data-r=clashing-bar]', resultEl);
    if (matchingBar && clashingBar) {
      matchingBar.style.width = `${Math.round((scores.matchingAvgMs / maxMs) * 100)}%`;
      clashingBar.style.width = `${Math.round((scores.clashingAvgMs / maxMs) * 100)}%`;
    }

    // Meaning & tip
    $('[data-r=meaning]', resultEl).textContent = meaningLine(scores);
    $('[data-r=tip]', resultEl).textContent = copy.tip;

    // Your own record to compare later. Nothing is saved.
    copyText = [
      measured ? `Stroop effect: ${effectLabel(scores.stroopEffectMs)} (${band.badge})` : copy.notMeasured,
      `Matching: ${scores.matchingAvgMs} ms · Clashing: ${scores.clashingAvgMs} ms · Accuracy: ${scores.accuracy}%`,
      `knowpsyche.com/stroop-test · ${today()}`,
    ].join('\n');

    // Share card
    void share.update({
      label: resultUi.shareLabel,
      big: !measured ? 'None' : slowed ? String(scores.stroopEffectMs) : copy.noSlowdownLabel,
      unit: measured && slowed ? 'ms' : '',
      badge: measured ? band.badge : '',
      tagline: resultUi.shareTagline,
      tag: 'Test / 06',
      text: measured ? shareText(scores.stroopEffectMs) : copy.notMeasured,
      url: 'https://knowpsyche.com/stroop-test/',
      filename: 'stroop-test-knowpsyche',
    });

    saveOptIn.show({
      testId: 'stroop',
      badge: measured ? band.badge : '',
      headline: headline.textContent ?? '',
      data: measured ? scores.stroopEffectMs : null,
    });

    resultEl.scrollIntoView({ behavior: scrollBehavior(), block: 'start' });
  }

  function restartAll() {
    clearTimers();
    mode = 'idle';
    trialIndex = 0;
    responses = [];
    answeredThisTrial = false;
    counter.textContent = ui.practiceLabel;
    note.textContent = ui.practiceNote;
    blankWord();
    feedbackEl.textContent = '';
    resultEl.hidden = true;
    saveOptIn.reset();
    setView('idle');
  }

  // Answer buttons. Pointers answer on pointerdown: "click" only fires once the finger lifts, which
  // would add the length of the tap to every time. Click still answers for keyboard activation.
  choiceBtns.forEach((btn) => {
    const color = btn.dataset.color as StroopColor;
    btn.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      // Stops the button taking focus after the answer; on the last word focus has moved to the result.
      e.preventDefault();
      handleAnswer(color, e.timeStamp);
    });
    btn.addEventListener('click', (e) => {
      if (e.detail === 0) handleAnswer(color, e.timeStamp);
    });
    // A held Enter repeats, and each repeat clicks the button again: it would answer the next words
    // too. Only the first press counts (Space clicks once, on release).
    btn.addEventListener('keydown', (e) => {
      if (e.repeat && (e.key === 'Enter' || e.key === ' ')) e.preventDefault();
    });
  });

  startPracticeBtn.addEventListener('click', startPractice);
  startMainBtn.addEventListener('click', startMainRun);
  // After a restart, Space or Enter on the focused button starts practice again.
  restartBtn.addEventListener('click', () => {
    restartAll();
    startPracticeBtn.focus({ preventScroll: true });
  });
  // A paused run has focus here, so Space or Enter restarts straight into practice.
  pausedRestartBtn.addEventListener('click', () => {
    restartAll();
    startPractice();
  });

  // Top "Start the test" button in the intro header
  const introStartBtn = $('[data-test-start]');
  introStartBtn?.addEventListener('click', () => {
    card.scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
    if (mode === 'idle') {
      startPractice();
    } else if (mode === 'practice-done') {
      startMainRun();
    } else if (mode === 'paused' || mode === 'done') {
      // A broken or finished run: clear it and begin a new one, like the other tests.
      restartAll();
      startPractice();
    }
  });

  // Try again button
  $$('[data-try-again]').forEach((btn) => {
    btn.addEventListener('click', () => {
      restartAll();
      // The pressed button is now hidden with the result; give focus somewhere useful.
      startPracticeBtn.focus({ preventScroll: true });
      card.scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
    });
  });

  // Keyboard: Space or Enter starts (Space alone after a finished run), R / B / G / Y answer. Shortcuts with Cmd/Ctrl/Alt (Cmd+R reload)
  // are left alone, and Space/Enter on a focused button or link does that control's own job.
  const keyColors: Record<string, StroopColor> = { r: 'red', b: 'blue', g: 'green', y: 'yellow' };
  window.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (!isCardOnScreen()) return;
    const key = e.key.toLowerCase();
    if (key === ' ' || key === 'enter') {
      if (mode !== 'idle' && mode !== 'practice-done' && mode !== 'paused' && mode !== 'done') return;
      // After a finished run only Space starts again (held keys don't), and only when no control
      // has focus (FAQ, fields).
      if (mode === 'done' && (key !== ' ' || e.repeat || (e.target as HTMLElement).closest('input, select, textarea, summary, [contenteditable]'))) return;
      // The answer buttons do nothing between runs, so Space/Enter on them still starts.
      const control = (e.target as HTMLElement).closest('a, button');
      if (control && !control.classList.contains('st-btn')) return;
      e.preventDefault();
      if (mode === 'idle') startPractice();
      else if (mode === 'paused' || mode === 'done') {
        if (mode === 'done') card.scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
        restartAll();
        startPractice();
      } else startMainRun();
      return;
    }
    const color = keyColors[key];
    if (!color || (mode !== 'practice' && mode !== 'main')) return;
    e.preventDefault();
    // A held key repeats; only the first press counts.
    if (e.repeat) return;
    handleAnswer(color, e.timeStamp);
  });

  bindFeedbackToggle();
</script>
