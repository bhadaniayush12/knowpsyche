---
import BaseLayout from '../layouts/BaseLayout.astro';
import FontPreloads from '../components/FontPreloads.astro';
import Hero from '../components/home/Hero.astro';
import QuestionMarquee from '../components/home/QuestionMarquee.astro';
import TestGrid from '../components/home/TestGrid.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import ResultsFaq from '../components/home/ResultsFaq.astro';
import { homeFaqs } from '../data/home';

const title = 'Free Psychology Tests, Explained | KnowPsyche';
// Drafted: shortened to fit 155 characters.
const description =
  'Free psychology tests that explain your result in plain English. Reaction time, Enneagram, memory, attention and more. Your answers stay in your browser.';

const site = 'https://knowpsyche.com';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    name: 'KnowPsyche',
    url: `${site}/`,
    description,
    publisher: { '@id': `${site}/#organization` },
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site}/#organization`,
    name: 'KnowPsyche',
    url: `${site}/`,
    logo: `${site}/icon-512.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout title={title} description={description} path="/" variant="home">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <FontPreloads slot="head" />
  <Hero />
  <QuestionMarquee />
  <TestGrid />
  <HowItWorks />
  <ResultsFaq />
</BaseLayout>
