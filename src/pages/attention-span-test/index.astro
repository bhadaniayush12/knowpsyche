---
import TestPage from '../../layouts/TestPage.astro';
import ResultHeadline from '../../components/result/ResultHeadline.astro';
import ScoreVisual from '../../components/result/ScoreVisual.astro';
import BandScale from '../../components/result/BandScale.astro';
import WhatItMeans from '../../components/result/WhatItMeans.astro';
import TryThis from '../../components/result/TryThis.astro';
import BandsNote from '../../components/result/BandsNote.astro';
import ShareCard from '../../components/result/ShareCard.astro';
import TryAgain from '../../components/result/TryAgain.astro';
import NextTest from '../../components/result/NextTest.astro';
import CopyScores from '../../components/result/CopyScores.astro';
import SaveResult from '../../components/result/SaveResult.astro';
import ProgressTrail from '../../components/result/ProgressTrail.astro';
import FeedbackToggle from '../../components/ui/FeedbackToggle.astro';
import { attentionBands, faqs, page, result, resultUi, sources, ui, happening } from '../../data/tests/attention-span';
import { TOTAL_TRIALS } from '../../lib/tests/attention-span';

const segClass = ['flex-[70] bg-paper', 'flex-[15] bg-lilac', 'flex-[10] bg-lilac-bright', 'flex-[5] bg-blue'];
const ranges = ['<70', '70–84', '85–94', '95+'];
---
<TestPage
  title={page.title}
  description={page.description}
  path="/attention-span-test/"
  crumb={page.crumb}
  eyebrow={page.eyebrow}
  h1={page.h1}
  intro={page.intro}
  introTouch={page.introTouch}
  metaLine={page.metaLine}
  faqs={faqs}
  sources={sources}
  happening={happening}
>
  <div
    slot="stage"
    tabindex="-1"
    class="as-card rounded-[26px] outline-none border border-line-card bg-white p-[clamp(16px,4vw,40px)] shadow-[0_26px_54px_rgba(36,34,56,.12)] select-none"
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <!-- Two lines reserved: on phones the counter and note sit on their own lines, top-aligned, so no state moves them (no layout shift). -->
      <div class="mono flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] max-sm:min-h-[calc(2lh+0.25rem)] max-sm:flex-col max-sm:items-start max-sm:justify-start">
        <span class="as-counter">{ui.practiceLabel}</span>
        <span class="as-note text-muted">{ui.practiceNote}</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <!-- basis-0: the label goes to two lines before Restart drops to a new row (only at large text sizes). -->
        <FeedbackToggle class="grow basis-0" />
        <button
          type="button"
          class="as-restart mono inline-flex min-h-11 shrink-0 items-center whitespace-nowrap border border-ink bg-transparent px-4 text-xs text-ink hover:border-blue hover:text-blue"
        >{ui.restart}</button>
      </div>
    </div>

    <!-- Progress bar across the top -->
    <div class="mt-4 h-1.5 w-full overflow-hidden rounded-full bg-line" aria-hidden="true">
      <div class="as-bar h-full w-0 rounded-full bg-blue transition-[width] duration-150"></div>
    </div>

    <!-- Stage arena: clickable everywhere -->
    <div
      role="region"
      aria-label={ui.arenaLabel}
      class="as-arena relative mt-4 flex h-[clamp(320px,46vw,440px)] w-full touch-manipulation select-none items-center justify-center rounded-[20px] border border-line-inner/40 bg-card text-center cursor-pointer transition-colors duration-150"
    >
      <!-- Idle view (before practice starts) -->
      <div data-as-view="idle" class="flex flex-col items-center gap-3 px-4">
        <p class="serif m-0 text-[clamp(28px,4vw,38px)] text-ink">{ui.practiceLabel}</p>
        <p class="pointer-swap m-0 max-w-[480px] text-[16.5px] leading-[1.55] text-ink-soft">
          <!-- From the doc intro. -->
          <span class="on-mouse">Click (or tap) when you see <b class="text-teal-ink">green</b>. Do nothing when you see a <b class="text-coral-ink">red circle with an X</b>.</span><span class="on-touch" set:html={ui.stageLineTouch} />
        </p>
        <button
          type="button"
          class="as-start-practice mono mt-2 inline-flex min-h-12 items-center justify-center rounded-12 border-0 bg-ink px-6 py-3 text-xs font-semibold text-paper transition-colors duration-200 hover:bg-blue"
        >
          <span class="pointer-swap"><span class="on-mouse">{ui.ready}</span><span class="on-touch">{ui.readyTouch}</span></span>
        </button>
      </div>

      <!-- Active Stimulus view -->
      <div data-as-view="active" class="flex flex-col items-center justify-center gap-4" hidden>
        <div class="as-circle size-[clamp(110px,22vw,160px)] rounded-full transition-transform duration-75"></div>
        <p class="as-feedback mono absolute inset-x-4 bottom-4 m-0 text-center text-[15px] font-medium" aria-live="polite"></p>
      </div>

      <!-- Practice complete view -->
      <div data-as-view="practice-done" class="flex flex-col items-center gap-3 px-4" hidden>
        <p class="serif m-0 text-[clamp(28px,4vw,38px)] text-ink">{ui.practiceDoneTitle}</p>
        <p class="m-0 max-w-[480px] text-[16.5px] leading-[1.55] text-ink-soft">{ui.practiceDoneText}</p>
        <button
          type="button"
          class="as-start-main mono mt-2 inline-flex min-h-12 items-center justify-center rounded-12 border-0 bg-ink px-6 py-3 text-xs font-semibold text-paper transition-colors duration-200 hover:bg-blue"
        >
          {ui.startMain}
        </button>
      </div>

      <!-- Paused view (when tab is hidden or blurred) -->
      <div data-as-view="paused" class="flex flex-col items-center gap-3 px-4" hidden>
        <p class="serif m-0 text-[clamp(28px,4vw,38px)] text-coral-ink">{ui.pausedTitle}</p>
        <p class="m-0 max-w-[480px] text-[16.5px] leading-[1.55] text-ink-soft">{ui.pausedMessage}</p>
        <button
          type="button"
          class="as-paused-restart mono mt-2 inline-flex min-h-12 items-center justify-center rounded-12 border-0 bg-ink px-6 py-3 text-xs font-semibold text-paper transition-colors duration-200 hover:bg-blue"
        >
          {ui.restart}
        </button>
      </div>
    </div>
  </div>

  <Fragment slot="result">
    <ResultHeadline />

    <ScoreVisual>
      <div class="flex flex-wrap items-stretch gap-[clamp(24px,4vw,40px)]">
        <div class="flex min-w-0 flex-[999_1_520px] flex-col gap-[22px]">
          <div class="flex flex-wrap items-end gap-[18px]">
            <div class="text-[clamp(88px,14vw,200px)] leading-[.8] font-semibold tracking-[-.07em]">
              <span data-r="overall">0</span><span class="ml-2 text-[.32em] tracking-[-.03em]">/ 100</span>
            </div>
            <div class="serif pb-2.5 text-[34px] text-blue" data-r="badge">Steady</div>
          </div>
          <BandScale segments={attentionBands.map((b, i) => ({ class: segClass[i], range: ranges[i], label: b.badge }))} />
        </div>

        <div class="flex min-w-0 flex-[1_1_320px] flex-col justify-between gap-4 border border-ink bg-card p-[22px]">
          <div class="mono text-[11px] text-muted">{resultUi.breakdownTitle}</div>
          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1 border-t border-line-inner pt-2">
              <span class="mono text-[10.5px] text-muted">Focus</span>
              <span class="text-[28px] font-semibold tracking-[-.03em] text-teal-ink" data-r="focus">0%</span>
              <span class="text-[12px] text-ink-soft">{resultUi.focusDetail}</span>
            </div>
            <div class="flex flex-col gap-1 border-t border-line-inner pt-2">
              <span class="mono text-[10.5px] text-muted">Self-control</span>
              <span class="text-[28px] font-semibold tracking-[-.03em] text-teal-ink" data-r="self-control">0%</span>
              <span class="text-[12px] text-ink-soft">{resultUi.selfControlDetail}</span>
            </div>
            <div class="flex flex-col gap-1 border-t border-line-inner pt-2">
              <span class="mono text-[10.5px] text-muted">Speed</span>
              <span class="text-[28px] font-semibold tracking-[-.03em] text-ink" data-r="speed">0 ms</span>
              <span class="text-[12px] text-ink-soft">{resultUi.speedDetail}</span>
            </div>
            <div class="flex flex-col gap-1 border-t border-line-inner pt-2">
              <span class="mono text-[10.5px] text-muted">Steadiness</span>
              <span class="text-[clamp(24px,7vw,28px)] font-semibold tracking-[-.03em] text-ink" data-r="steadiness">{resultUi.steady}</span>
              <span class="text-[12px] text-ink-soft" data-r="steadiness-detail">{resultUi.steadyDetail}</span>
            </div>
          </div>
          <CopyScores label={ui.copyScore} class="mt-1 border-t border-line-inner pt-3" />
        </div>
      </div>
    </ScoreVisual>

    <WhatItMeans change={result.change} />

    <TryThis />

    <BandsNote />

    <SaveResult testId="attention-span" />

    <ShareCard>
      <TryAgain />
    </ShareCard>

    <ProgressTrail variant="card" current="attention-span" />

    <NextTest from="/attention-span-test/" line={result.nextLine} learn={result.learn} />
  </Fragment>
</TestPage>

<style is:global>
  .as-circle[data-color='green'] {
    background-color: var(--color-teal-deep);
    box-shadow: 0 0 28px rgba(47, 111, 99, 0.45);
  }
  .as-circle[data-color='red'] {
    background-color: var(--color-red);
    box-shadow: 0 0 28px rgba(201, 88, 75, 0.45);
  }
  /* Red also carries a white X, so colour is never the only signal (white on red is 4.2:1). */
  .as-circle {
    position: relative;
  }
  .as-circle[data-color='red']::before,
  .as-circle[data-color='red']::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 52%;
    height: 11%;
    border-radius: 999px;
    background: #fff;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .as-circle[data-color='red']::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .as-circle[data-blank] {
    opacity: 0;
    transform: scale(0.85);
  }
  @media (prefers-reduced-motion: reduce) {
    .as-circle {
      transition: none !important;
    }
  }
</style>

<script>
  import { placeMarker } from '../../lib/band-scale';
  import { result as copy, resultUi, ui } from '../../data/tests/attention-span';
  import {
    calculateAttentionScores,
    generateAttentionTrials,
    getBand,
    getGapMs,
    getPracticeTrials,
    meaningLine,
    scalePercent,
    shareText,
    CIRCLE_DURATION_MS,
    TOTAL_TRIALS,
    type AttentionScores,
    type CircleColor,
    type TrialResult,
  } from '../../lib/tests/attention-span';
  import { createShareCard } from '../../lib/share-card';
  import { bindFeedbackToggle, cue } from '../../lib/feedback';
  import { initSaveOptIn } from '../../lib/saved-results';
  import { $, $$, bindCopy, guardLeave, onScreen, prefersReducedMotion, runFor, today } from '../../lib/test-ui';

  type Mode = 'idle' | 'practice' | 'practice-done' | 'main' | 'paused' | 'done';

  const card = $('.as-card');
  const arena = $('.as-arena');
  const counter = $('.as-counter');
  const note = $('.as-note');
  const bar = $('.as-bar');
  const restartBtn = $('.as-restart');
  const startPracticeBtn = $('.as-start-practice');
  const startMainBtn = $('.as-start-main');
  const pausedRestartBtn = $('.as-paused-restart');
  const circleEl = $('.as-circle');
  const feedbackEl = $('.as-feedback');
  const resultEl = $('[data-result]');
  const saveOptIn = initSaveOptIn($('[data-save-optin]', resultEl));
  const isCardOnScreen = onScreen(card);
  // "Tap" on touch screens, "click" with a mouse.
  const touch = window.matchMedia('(pointer: coarse)').matches;
  const scrollBehavior = (): ScrollBehavior => (prefersReducedMotion() ? 'auto' : 'smooth');

  const views = {
    idle: $('[data-as-view="idle"]', arena),
    active: $('[data-as-view="active"]', arena),
    practiceDone: $('[data-as-view="practice-done"]', arena),
    paused: $('[data-as-view="paused"]', arena),
  };

  const share = createShareCard($('[data-share]'));

  // Bound once; the text is filled in when a result is shown.
  let copyText = '';
  bindCopy($('[data-copy-scores]', resultEl), $('[data-copy-status]', resultEl), () => copyText);

  let mode: Mode = 'idle';
  let trialList: CircleColor[] = [];
  let trialIndex = 0;
  let trialResults: TrialResult[] = [];
  let currentTrialClicked = false;
  // Onset of the circle on screen: the timestamp of the frame that paints it.
  let stimulusPaintTime = 0;
  let cancel: () => void = () => {};

  function setView(target: 'idle' | 'active' | 'practiceDone' | 'paused') {
    views.idle.hidden = target !== 'idle';
    views.active.hidden = target !== 'active';
    views.practiceDone.hidden = target !== 'practiceDone';
    views.paused.hidden = target !== 'paused';
  }

  function clearTimers() {
    cancel();
    cancel = () => {};
  }

  function blankCircle() {
    circleEl.removeAttribute('data-color');
    circleEl.setAttribute('data-blank', '');
  }

  // A hidden tab or lost focus breaks the timing, so the run stops and is never scored.
  function pauseBrokenRun() {
    if (mode !== 'main' && mode !== 'practice') return;
    clearTimers();
    mode = 'paused';
    blankCircle();
    feedbackEl.textContent = '';
    // A broken scored run has no result, so its reserved space goes too (no empty gap below).
    resultEl.hidden = true;
    setView('paused');
    pausedRestartBtn.focus({ preventScroll: true });
  }

  // Guard against broken runs when tab loses focus or visibility
  window.addEventListener('blur', pauseBrokenRun);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) pauseBrokenRun();
  });

  guardLeave(() => mode === 'main' || mode === 'practice', ui.leaveWarning);

  function startPractice() {
    clearTimers();
    mode = 'practice';
    trialList = getPracticeTrials();
    trialIndex = 0;
    trialResults = [];
    counter.textContent = ui.practiceLabel;
    note.textContent = ui.practiceNote;
    bar.style.width = '0%';
    feedbackEl.textContent = '';
    setView('active');
    runNextTrial();
  }

  function startMainRun() {
    clearTimers();
    mode = 'main';
    trialList = generateAttentionTrials();
    trialIndex = 0;
    // Practice answers are thrown away here: only the 80 main circles are scored.
    // The result's space is taken now, invisibly, while this click or key explains why the page grew.
    // The run can end with no input (last stimulus not answered), and showing it then would make
    // everything below jump.
    resultEl.classList.add('invisible');
    resultEl.hidden = false;
    trialResults = [];
    counter.textContent = ui.circleCount(1, TOTAL_TRIALS);
    note.textContent = ui.mainNote;
    bar.style.width = '0%';
    setView('active');
    feedbackEl.textContent = '';
    runNextTrial();
  }

  /** Practice only: the scored run gives no feedback, so it plays no sound either. */
  function setFeedback(text: string, good: boolean) {
    cue(good ? 'right' : 'wrong');
    feedbackEl.textContent = text;
    feedbackEl.className = `as-feedback mono absolute inset-x-4 bottom-4 m-0 text-center text-[15px] font-medium ${good ? 'text-teal-ink' : 'text-coral-ink'}`;
  }

  // Gap (0.8–1.6 s, blank) → circle for exactly 0.5 s → next gap. Every step is checked per frame
  // against performance.now() (runFor), so nothing drifts the way chained setTimeouts do.
  /** `from` = the frame the previous circle was hidden in, so the gap is timed from what was painted. */
  function runNextTrial(from?: number) {
    if (trialIndex >= trialList.length) {
      if (mode === 'practice') {
        mode = 'practice-done';
        counter.textContent = ui.practiceDoneTitle;
        note.textContent = ui.practiceDoneNote;
        bar.style.width = '100%';
        setView('practiceDone');
      } else if (mode === 'main') {
        finishMainTest();
      }
      return;
    }

    currentTrialClicked = false;
    const color = trialList[trialIndex];
    if (mode === 'main') {
      counter.textContent = ui.circleCount(trialIndex + 1, TOTAL_TRIALS);
      bar.style.width = `${Math.round((trialIndex / TOTAL_TRIALS) * 100)}%`;
    } else {
      counter.textContent = ui.practiceCount(trialIndex + 1, trialList.length);
    }

    blankCircle();
    cancel = runFor(getGapMs(), (shownAt) => {
      // Painted at the end of this frame, so this frame's timestamp is the onset.
      stimulusPaintTime = shownAt;
      feedbackEl.textContent = '';
      circleEl.removeAttribute('data-blank');
      circleEl.setAttribute('data-color', color);

      cancel = runFor(CIRCLE_DURATION_MS, (hiddenAt) => {
        blankCircle();
        if (!currentTrialClicked) {
          trialResults.push({ color, clicked: false });
          if (mode === 'practice') {
            if (color === 'red') setFeedback(ui.niceIgnored, true);
            else setFeedback(touch ? ui.oopsGreenTouch : ui.oopsGreen, false);
          }
        }
        trialIndex++;
        runNextTrial(hiddenAt);
      }, undefined, shownAt);
    }, undefined, from);
  }

  /** `t` = the input event's high-resolution timestamp. */
  function handleResponse(t: number) {
    if (mode !== 'practice' && mode !== 'main') return;
    if (currentTrialClicked) return;
    // Only accept clicks while stimulus is visible
    if (!circleEl.hasAttribute('data-color')) return;

    currentTrialClicked = true;
    const rt = Math.max(1, Math.round((t >= stimulusPaintTime ? t : performance.now()) - stimulusPaintTime));
    const color = trialList[trialIndex];
    trialResults.push({ color, clicked: true, reactionTimeMs: rt });

    if (mode === 'practice') {
      if (color === 'green') setFeedback(ui.nice, true);
      else setFeedback(ui.oopsRed, false);
    }
  }

  function finishMainTest() {
    clearTimers();
    mode = 'done';
    bar.style.width = '100%';
    const scores = calculateAttentionScores(trialResults);
    renderResults(scores);
  }

  function renderResults(scores: AttentionScores) {
    const band = getBand(scores.overall);
    resultEl.hidden = false;
    resultEl.classList.remove('invisible');

    // Headline
    $('[data-r=eyebrow]', resultEl).textContent = resultUi.eyebrow;
    const headline = $('[data-r=headline]', resultEl);
    headline.textContent = `${band.badge} · ${scores.overall} / 100`;
    headline.focus({ preventScroll: true });

    // Scores
    $('[data-r=overall]', resultEl).textContent = String(scores.overall);
    $('[data-r=badge]', resultEl).textContent = band.badge;

    // Marker
    placeMarker(resultEl, scalePercent(scores.overall), `You · ${scores.overall}`);

    // Breakdown
    $('[data-r=focus]', resultEl).textContent = `${scores.focus}%`;
    $('[data-r=self-control]', resultEl).textContent = `${scores.selfControl}%`;
    $('[data-r=speed]', resultEl).textContent = scores.speed > 0 ? `${scores.speed} ms` : 'None';

    const steadinessEl = $('[data-r=steadiness]', resultEl);
    const steadinessDetailEl = $('[data-r=steadiness-detail]', resultEl);
    if (scores.steadiness.dipped) {
      steadinessEl.textContent = resultUi.dipped;
      steadinessEl.className = 'text-[clamp(24px,7vw,28px)] font-semibold tracking-[-.03em] text-coral-ink';
      steadinessDetailEl.textContent = resultUi.dippedDetail(scores.steadiness.diff);
    } else {
      steadinessEl.textContent = resultUi.steady;
      steadinessEl.className = 'text-[clamp(24px,7vw,28px)] font-semibold tracking-[-.03em] text-teal-ink';
      steadinessDetailEl.textContent = resultUi.steadyDetail;
    }

    // Meaning & tip
    $('[data-r=meaning]', resultEl).textContent = meaningLine(scores, touch);
    $('[data-r=tip]', resultEl).textContent = copy.tip;

    // Your own record to compare later. Nothing is saved.
    copyText = [
      `Attention span: ${scores.overall}/100 (${band.badge})`,
      `Focus: ${scores.focus}% · Self-control: ${scores.selfControl}% · Speed: ${scores.speed} ms`,
      `Steadiness: ${scores.steadiness.dipped ? resultUi.copyDipped : resultUi.steady}`,
      `knowpsyche.com/attention-span-test · ${today()}`,
    ].join('\n');

    // Share card
    void share.update({
      label: resultUi.shareLabel,
      big: String(scores.overall),
      unit: '/ 100',
      badge: band.badge,
      tagline: resultUi.shareTagline,
      tag: 'Test / 05',
      text: shareText(scores.overall),
      url: 'https://knowpsyche.com/attention-span-test/',
      filename: 'attention-span-knowpsyche',
    });

    saveOptIn.show({
      testId: 'attention-span',
      badge: band.badge,
      headline: `${band.badge} · ${scores.overall} / 100`,
      data: scores.overall,
    });

    resultEl.scrollIntoView({ behavior: scrollBehavior(), block: 'start' });
  }

  function restartAll() {
    clearTimers();
    mode = 'idle';
    trialIndex = 0;
    trialResults = [];
    currentTrialClicked = false;
    counter.textContent = ui.practiceLabel;
    note.textContent = ui.practiceNote;
    bar.style.width = '0%';
    blankCircle();
    feedbackEl.textContent = '';
    resultEl.hidden = true;
    saveOptIn.reset();
    setView('idle');
  }

  // The mode when the arena's last pointerdown happened. A press on the last practice circle can
  // still be down when "Practice complete" shows; its click must not start the scored run.
  let pressMode: Mode | null = null;

  // Interactive events: Arena click / tap
  arena.addEventListener('click', (e) => {
    // If clicking on a button inside arena (e.g. start buttons), let button handle it
    const target = e.target as HTMLElement;
    if (target.closest('button')) return;

    if (mode === 'idle') {
      startPractice();
    } else if (mode === 'practice-done' && pressMode === 'practice-done') {
      startMainRun();
    }
  });
  // Responses are taken on pointerdown: "click" only fires once the finger lifts, which would add
  // the length of the tap to every reaction time (same as the reaction time test).
  arena.addEventListener('pointerdown', (e) => {
    pressMode = mode;
    if (mode !== 'practice' && mode !== 'main') return;
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    if ((e.target as HTMLElement).closest('button')) return;
    e.preventDefault();
    handleResponse(e.timeStamp);
  });

  startPracticeBtn.addEventListener('click', startPractice);
  startMainBtn.addEventListener('click', startMainRun);
  // After a restart, Space or Enter on the focused button starts practice again.
  restartBtn.addEventListener('click', () => {
    restartAll();
    startPracticeBtn.focus({ preventScroll: true });
  });
  // A paused run has focus here, so Space or Enter restarts straight into practice.
  pausedRestartBtn.addEventListener('click', () => {
    restartAll();
    startPractice();
  });

  // Top "Start the test" button in the intro header
  const introStartBtn = $('[data-test-start]');
  introStartBtn?.addEventListener('click', () => {
    card.scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
    if (mode === 'idle') {
      startPractice();
    } else if (mode === 'practice-done') {
      startMainRun();
    } else if (mode === 'paused' || mode === 'done') {
      // A broken or finished run: clear it and begin a new one, like the other tests.
      restartAll();
      startPractice();
    }
  });

  // Try again button
  $$('[data-try-again]').forEach((btn) => {
    btn.addEventListener('click', () => {
      restartAll();
      // The pressed button is now hidden with the result; give focus somewhere useful.
      startPracticeBtn.focus({ preventScroll: true });
      card.scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
    });
  });

  // Keyboard: Space starts, answers, and starts again after a finished run. On a focused button or link, Space does that control's own
  // job, except during a run, when it always answers (bar Restart, so keyboard users can still restart).
  // Enter answers too, but only during a run; otherwise it keeps its usual job on the focused control.
  window.addEventListener('keydown', (e) => {
    if ((e.key !== ' ' && e.key !== 'Enter') || e.metaKey || e.ctrlKey || e.altKey) return;
    // Don't intercept Space if scrolling outside test
    if (!isCardOnScreen()) return;
    const target = e.target as HTMLElement;
    const running = mode === 'practice' || mode === 'main';
    if (e.key === 'Enter' && !running) return;
    if (running ? target === restartBtn || target === pausedRestartBtn : !!target.closest('a, button')) return;
    if (!running && mode !== 'idle' && mode !== 'practice-done' && mode !== 'paused' && mode !== 'done') return;
    // After a finished run, Space starts again only when no control has focus (FAQ, fields).
    if (mode === 'done' && target.closest('input, select, textarea, summary, [contenteditable]')) return;
    e.preventDefault();
    // A held key repeats; only the first press counts.
    if (e.repeat) return;
    if (mode === 'idle') startPractice();
    else if (mode === 'practice-done') startMainRun();
    else if (mode === 'paused' || mode === 'done') {
      if (mode === 'done') card.scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
      restartAll();
      startPractice();
    } else handleResponse(e.timeStamp);
  });

  bindFeedbackToggle();
</script>
