---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FontPreloads from '../components/FontPreloads.astro';

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. `/` or `/about/`. */
  path: string;
  /** 1200×630 PNG, absolute URL or site-relative path. Made by scripts/og.mjs. */
  ogImage?: string;
  noindex?: boolean;
  /**
   * Breadcrumb trail after Home; the last item is this page. Renders the visible breadcrumb and the
   * matching `BreadcrumbList` JSON-LD. Inner pages only.
   */
  crumbs?: { name: string; href?: string }[];
  /** Max width of the breadcrumb row, to line up with the page's content column. */
  crumbWidth?: number;
  /** `home` = Main design header + full footer. `inner` = About/Method design header + compact footer. */
  variant?: 'home' | 'inner';
  /** Preload the above-the-fold fonts so they swap in before first paint (no layout shift). On by default. */
  preloadFonts?: boolean;
  /** Also preload weight 700, for a page whose test uses it (the Stroop word, the report). */
  preloadBold?: boolean;
}

const { title, description, path, ogImage = '/og/site.png', noindex = false, crumbs, crumbWidth = 1200, variant = 'inner', preloadFonts = true, preloadBold = false } = Astro.props;
const site = Astro.site ?? new URL('https://knowpsyche.com');
// Google Analytics 4 measurement ID (public, set in .env.production). Empty = no analytics code at all.
const gaId = (import.meta.env.PUBLIC_GA_ID ?? '').trim();
const canonical = new URL(path, site).href;
const image = new URL(ogImage, site).href;
// One list drives both the visible breadcrumb and the JSON-LD, so they always match.
const trail = crumbs?.length
  ? [{ name: 'Home', href: '/' }, ...crumbs.slice(0, -1), { ...crumbs[crumbs.length - 1], href: path }]
  : [];
const breadcrumbLd = trail.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href!, site).href,
  })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F4F0E7" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KnowPsyche" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {preloadFonts && <FontPreloads bold={preloadBold} />}
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    <slot name="head" />
    {/*
      Google Analytics 4: the automatic page_view only, no events, no user properties, no extra parameters.
      Runs only on knowpsyche.com (checked here, before any request to Google), loads 3 s after the window
      load event once the browser is idle (outside Lighthouse's measuring window), and waits while a test is running (window.kpTestRunning,
      set by guardLeave in src/lib/test-ui.ts). Test answers, results and names never reach it.
    */}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        if (location.hostname === 'knowpsyche.com' || location.hostname === 'www.knowpsyche.com') {
          var kpLoadGa = function () {
            if (window.kpTestRunning && window.kpTestRunning()) return setTimeout(kpLoadGa, 2000);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { dataLayer.push(arguments); };
            gtag('js', new Date());
            gtag('config', gaId, { allow_google_signals: false, allow_ad_personalization_signals: false });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
            document.head.appendChild(s);
          };
          var kpLater = function () {
            setTimeout(function () {
              if ('requestIdleCallback' in window) requestIdleCallback(kpLoadGa, { timeout: 2000 });
              else kpLoadGa();
            }, 3000);
          };
          if (document.readyState === 'complete') kpLater();
          else addEventListener('load', kpLater, { once: true });
        }
      </script>
    )}
  </head>
  {/* Flex column at full screen height, so the footer sits at the bottom of short pages. */}
  <body id="top" class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-10 bg-ink px-4 py-3 text-paper focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center focus:text-paper"
    >Skip to content</a>
    <Header variant={variant} />
    <main id="main" class="flex-1">
      {trail.length > 0 && (
        <nav aria-label="Breadcrumb" class="mono mx-auto px-[clamp(16px,3vw,40px)] pt-7 text-[11px] text-muted" style={{ maxWidth: `${crumbWidth}px` }}>
          {trail.map((c, i) => i < trail.length - 1
            ? <><a href={c.href} class="hit-44 text-muted">{c.name}</a> / </>
            : <span aria-current="page">{c.name}</span>)}
        </nav>
      )}
      <slot />
    </main>
    <Footer variant={variant === 'home' ? 'full' : 'compact'} />

    <script>
      // Pause animations in [data-motion-zone] sections while they're off screen (see global.css).
      const zones = document.querySelectorAll<HTMLElement>('[data-motion-zone]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) (e.target as HTMLElement).toggleAttribute('data-onscreen', e.isIntersecting);
        });
        zones.forEach((z) => io.observe(z));
      } else {
        zones.forEach((z) => z.setAttribute('data-onscreen', ''));
      }
    </script>
  </body>
</html>
