---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. `/` or `/about/`. */
  path: string;
  /** Absolute URL or site-relative path. Left out of the tags when not given. */
  ogImage?: string;
  noindex?: boolean;
  /** `home` = Main design header + full footer. `inner` = About/Method design header + compact footer. */
  variant?: 'home' | 'inner';
}

const { title, description, path, ogImage, noindex = false, variant = 'inner' } = Astro.props;
const site = Astro.site ?? new URL('https://knowpsyche.com');
const canonical = new URL(path, site).href;
const image = ogImage ? new URL(ogImage, site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F4F0E7" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KnowPsyche" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}

    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <slot name="head" />
  </head>
  <body id="top">
    <a
      href="#main"
      class="sr-only z-50 rounded-10 bg-ink px-4 py-3 text-paper focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:text-paper"
    >Skip to content</a>
    <Header variant={variant} />
    <main id="main">
      <slot />
    </main>
    <Footer variant={variant === 'home' ? 'full' : 'compact'} />

    <script>
      // Pause animations in [data-motion-zone] sections while they're off screen (see global.css).
      const zones = document.querySelectorAll<HTMLElement>('[data-motion-zone]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) (e.target as HTMLElement).toggleAttribute('data-onscreen', e.isIntersecting);
        });
        zones.forEach((z) => io.observe(z));
      } else {
        zones.forEach((z) => z.setAttribute('data-onscreen', ''));
      }
    </script>
  </body>
</html>
