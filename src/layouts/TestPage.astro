---
/**
 * Shared layout for all 7 tests: intro → test stage → result → FAQ → sources.
 * Layout from docs/design/Test.dc.html; result pattern from CLAUDE.md.
 *
 * Slots:
 * - `controls`: options next to the intro (e.g. mode picker)
 * - `stage`: the running test
 * - `result`: result components, shown when the page script unhides `[data-result]`
 *
 * The Start button has `data-test-start`; the page script decides what it does.
 */
import BaseLayout from './BaseLayout.astro';
// Weight 500 isn't used above the fold, so without a preload it would load mid-test. The others are the
// fonts above the fold: preloaded so they swap in before first paint and the intro doesn't shift.
// Same hashed files as the @fontsource CSS.
import grotesk400 from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import grotesk500 from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import grotesk600 from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import mono400 from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/result/Faq.astro';
import Sources from '../components/result/Sources.astro';
import { PRIVATE_LINE, type Faq as FaqItem, type Source } from '../data/shared';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Short page name for breadcrumbs, e.g. "Reaction time". */
  crumb: string;
  /** Mono line above the H1, e.g. "Test / 01 · Attention · 1–2 min". */
  eyebrow: string;
  h1: string;
  intro: string;
  /** Intro for touch screens ("tap" instead of "click"). Swapped with CSS on `pointer: coarse`, so nothing shifts. */
  introTouch?: string;
  /** Time / questions / saved line, e.g. "About 1 minute · 5 tries · Nothing saved". */
  metaLine: string;
  startLabel?: string;
  faqs: FaqItem[];
  sources: Source[];
  /** Optional note under the sources list. */
  sourcesNote?: string;
  ogImage?: string;
}

const { title, description, path, crumb, eyebrow, h1, intro, introTouch, metaLine, startLabel = 'Start the test', faqs, sources, sourcesNote, ogImage } = Astro.props;

// The design sets the last word of the H1 in the serif accent.
const cut = h1.lastIndexOf(' ');
const h1Lead = cut > 0 ? h1.slice(0, cut + 1) : '';
const h1Accent = cut > 0 ? h1.slice(cut + 1) : h1;
---
<BaseLayout title={title} description={description} path={path} crumbs={[{ name: 'Tests', href: '/tests/' }, { name: crumb }]} crumbWidth={1120} ogImage={ogImage}>
  {[grotesk400, grotesk500, grotesk600, serifItalic, mono400].map((href) => <link slot="head" rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  <div class="mx-auto max-w-[1120px] px-[clamp(16px,3vw,40px)] pt-[18px] pb-20">

    <section class="mb-[22px] flex flex-wrap items-end justify-between gap-5" aria-labelledby="test-title">
      <div class="min-w-0 max-w-[620px]">
        <div class="mono mb-2.5 text-[11px] text-blue">{eyebrow}</div>
        <h1 id="test-title" class="m-0 text-[clamp(40px,5.4vw,72px)] leading-[.95] font-semibold tracking-[-.05em]">{h1Lead}<span class="serif text-blue">{h1Accent}</span></h1>
        <p class:list={['mt-3 mb-0 max-w-[560px] text-[17px] leading-[1.55] text-ink-soft', introTouch && 'intro-swap']}>
          {introTouch ? <><span class="intro-mouse">{intro}</span><span class="intro-touch">{introTouch}</span></> : intro}
        </p>
        <p class="mono mt-3 mb-0 text-[11px] text-muted">{metaLine}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          <button
            type="button"
            data-test-start
            class="inline-flex min-h-12 items-center rounded-12 border-0 bg-ink px-5 py-3 text-base font-semibold text-paper transition-colors duration-300 ease-house hover:bg-blue"
          >{startLabel}</button>
          <p class="m-0 text-[13.5px] text-ink-soft">{PRIVATE_LINE}</p>
        </div>
      </div>
      <slot name="controls" />
    </section>

    <section aria-label="Test" data-stage>
      <slot name="stage" />
    </section>

    <section data-result hidden aria-label="Your result" class="mt-14 flex flex-col gap-[clamp(32px,5vw,48px)]">
      <slot name="result" />
    </section>

    <!-- Below the test and its result, never inside it. -->
    <AdSlot class="my-10" />

    <div class="mt-14 flex max-w-[760px] flex-col gap-12">
      <Faq faqs={faqs} />
      <Sources sources={sources} note={sourcesNote} />
    </div>
  </div>
</BaseLayout>

<style>
  /* Both intros sit in one grid cell and the unused one is hidden with visibility, so the box is always
     as tall as the longer one. Otherwise the shorter "tap" line wraps differently once the web font
     swaps in, and everything below it jumps. visibility:hidden also hides it from screen readers. */
  .intro-swap { display: grid; }
  .intro-swap > span { grid-area: 1 / 1; }
  .intro-touch { visibility: hidden; }
  @media (pointer: coarse) {
    .intro-mouse { visibility: hidden; }
    .intro-touch { visibility: visible; }
  }
</style>
