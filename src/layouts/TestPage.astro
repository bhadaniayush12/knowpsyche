---
/**
 * Shared layout for all 7 tests: intro → test stage → result → FAQ → sources.
 * Layout from docs/design/Test.dc.html; result pattern from CLAUDE.md.
 *
 * Slots:
 * - `controls`: options next to the intro (e.g. mode picker)
 * - `stage`: the running test
 * - `result`: result components, shown when the page script unhides `[data-result]`
 *
 * The Start button has `data-test-start`; the page script decides what it does.
 */
import BaseLayout from './BaseLayout.astro';
import ResearchDiagram from '../components/ResearchDiagram.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/result/Faq.astro';
import Sources from '../components/result/Sources.astro';
import WhatsHappening from '../components/result/WhatsHappening.astro';
import ProgressTrail from '../components/result/ProgressTrail.astro';
import TrailFlag from '../components/result/TrailFlag.astro';
import { NOSCRIPT_LINE, PRIVATE_LINE, type Faq as FaqItem, type Happening, type Source } from '../data/shared';
import { learnMoreLabel } from '../data/learn';
import { articlesForTest } from '../lib/learn/articles';
import { getCollection } from 'astro:content';
import type { TestId } from '../lib/saved-results';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Short page name for breadcrumbs, e.g. "Reaction time". */
  crumb: string;
  /** Mono line above the H1, e.g. "Test / 01 · Attention · 1–2 min". */
  eyebrow: string;
  h1: string;
  intro: string;
  /** Intro for touch screens ("tap" instead of "click"). Swapped with CSS on `pointer: coarse`, so nothing shifts. */
  introTouch?: string;
  /** Time / questions / saved line, e.g. "About 1 minute · 5 tries · Nothing saved". */
  metaLine: string;
  startLabel?: string;
  faqs: FaqItem[];
  sources: Source[];
  /** "What's happening in this test?", shown below the test and above the FAQ and Sources. */
  happening: Happening;
  /** Optional note under the sources list. */
  sourcesNote?: string;
  /** Defaults to the card scripts/og.mjs makes for this slug: /og/<slug>.png. */
  ogImage?: string;
  /** Preload Space Grotesk 700 too, when the running test uses it. */
  preloadBold?: boolean;
}

const { title, description, path, crumb, eyebrow, h1, intro, introTouch, metaLine, startLabel = 'Start the test', faqs, sources, happening, sourcesNote, ogImage = `/og/${path.replace(/\//g, '')}.png`, preloadBold = false } = Astro.props;

// The design sets the last word of the H1 in the serif accent.
const cut = h1.lastIndexOf(' ');
const h1Lead = cut > 0 ? h1.slice(0, cut + 1) : '';
const h1Accent = cut > 0 ? h1.slice(cut + 1) : h1;

// Learn articles that go with this test (relatedTest), shown near Sources. None published = no line.
// "/reaction-time-test/" → "reaction-time", for the progress trail.
const testId = path.replace(/^\/|-test\/$/g, '') as TestId;
const testCategory = testId === 'enneagram' || testId === 'emotional-intelligence' ? 'personality' : 'cognitive';
const questionCounts: Record<TestId, number> = {
  'reaction-time': 5,
  enneagram: 45,
  stroop: 40,
  'number-memory': 1,
  'photographic-memory': 1,
  'attention-span': 80,
  'emotional-intelligence': 28,
};

const articles = articlesForTest(await getCollection('learn'), path.replace(/\//g, ''));
---
<BaseLayout title={title} description={description} path={path} crumbs={[{ name: 'Tests', href: '/tests/' }, { name: crumb }]} crumbWidth={1120} ogImage={ogImage} preloadBold={preloadBold}>
  <TrailFlag slot="head" />
  <div class="mx-auto max-w-[1120px] px-[clamp(16px,3vw,40px)] pt-[18px] pb-20">

    {/* Only for people who saved a result (C1). Above the intro, never inside the running test. */}
    <ProgressTrail variant="strip" current={testId} />

    <section class="mb-[22px] flex flex-wrap items-end justify-between gap-5" aria-labelledby="test-title">
      <div class="min-w-0 max-w-[620px]">
        <div class="mono mb-2.5 text-[11px] text-blue">{eyebrow}</div>
        <h1 id="test-title" class="m-0 text-[clamp(40px,5.4vw,72px)] leading-[.95] font-semibold tracking-[-.05em]">{h1Lead}<span class="serif text-blue">{h1Accent}</span></h1>
        <p class:list={['mt-3 mb-0 max-w-[560px] text-[17px] leading-[1.55] text-ink-soft', introTouch && 'intro-swap']}>
          {introTouch ? <><span class="intro-mouse">{intro}</span><span class="intro-touch">{introTouch}</span></> : intro}
        </p>
        <p class="mono mt-3 mb-0 text-[11px] text-muted">{metaLine}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          <button
            type="button"
            data-test-start
            class="inline-flex min-h-12 items-center rounded-12 border-0 bg-ink px-5 py-3 text-base font-semibold text-paper transition-colors duration-300 ease-house hover:bg-blue"
          >{startLabel}</button>
          <p class="m-0 text-[13.5px] text-ink-soft">{PRIVATE_LINE}</p>
        </div>
        <noscript><p class="mt-3 mb-0 text-[15px] font-semibold text-ink">{NOSCRIPT_LINE}</p></noscript>
      </div>
      <slot name="controls" />
    </section>

    <section aria-label="Test" data-stage data-test-name={testId} data-test-category={testCategory} data-question-count={questionCounts[testId]}>
      <slot name="stage" />
    </section>

    <section data-result hidden aria-label="Your result" class="mt-14 flex flex-col gap-[clamp(32px,5vw,48px)]">
      <slot name="result" />
    </section>

    {/* Below the test and its result, never inside it. */}
    <AdSlot class="my-10" />

    <div class="mt-14 flex max-w-[760px] flex-col gap-12">
      <ResearchDiagram page={testId} />
      <WhatsHappening happening={happening} />
      <Faq faqs={faqs} />
      <div class="flex flex-col gap-6">
        {articles.length > 0 && (
          <p class="m-0 text-base leading-[1.6] text-ink-soft">
            {learnMoreLabel}{' '}
            {articles.map((a, i) => <>{i > 0 && ', '}<a href={`/learn/${a.id}/`} class="font-semibold text-ink underline underline-offset-[3px]">{a.data.title}</a></>)}
          </p>
        )}
        <Sources sources={sources} note={sourcesNote} />
      </div>
    </div>
  </div>
  <script>
  import { trackEvent } from '../lib/analytics';

  const stage = document.querySelector<HTMLElement>('[data-stage][data-test-name]');
  const result = document.querySelector<HTMLElement>('[data-result]');
  if (stage && result) {
    const test_name = stage.dataset.testName!;
    const test_category = stage.dataset.testCategory!;
    const question_count = Number(stage.dataset.questionCount);
    const language = document.documentElement.lang || 'en';
    let started = false;
    let resultVisible = false;

    const start = () => {
      if (started) return;
      started = true;
      trackEvent('test_start', { test_name, test_category, language });
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-test-start], [data-try-again], .as-start-practice, .st-start-practice')) start();
      if (target.closest('.eq-answer, .en-answer')) start();
      if (target.closest('.eq-restart, .en-restart, .rt-restart, .nm-restart, .pm-restart, .as-restart, .st-restart, .as-paused-restart, .st-paused-restart')) {
        started = false;
      }
      const share = target.closest<HTMLElement>('[data-share-action]');
      if (share && result.contains(share)) {
        const method = share.dataset.shareAction;
        if (method === 'share' || method === 'download' || method === 'copy') {
          trackEvent('result_share', { test_name, method });
        }
      }
    });

    const observeResult = () => {
      const visible = !result.hidden && !result.classList.contains('invisible');
      if (visible && !resultVisible) {
        trackEvent('test_complete', { test_name, test_category, language, question_count });
        started = false;
      }
      resultVisible = visible;
    };
    new MutationObserver(observeResult).observe(result, { attributes: true, attributeFilter: ['hidden', 'class'] });
  }
  </script>
</BaseLayout>

<style>
  /* Both intros sit in one grid cell and the unused one is hidden with visibility, so the box is always
     as tall as the longer one. Otherwise the shorter "tap" line wraps differently once the web font
     swaps in, and everything below it jumps. visibility:hidden also hides it from screen readers. */
  .intro-swap { display: grid; }
  .intro-swap > span { grid-area: 1 / 1; }
  .intro-touch { visibility: hidden; }
  @media (pointer: coarse) {
    .intro-mouse { visibility: hidden; }
    .intro-touch { visibility: visible; }
  }
</style>
